{"verses":[{"id":6131,"verse_number":1,"verse_key":"98:1","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":598,"text_uthmani":" لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ","trs":{"20":"Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief]<sup foot_note=197790>1</sup> until there came to them clear evidence","85":"Those who disbelieve among the People of the Book and the idolaters were not about to change their ways until they were sent clear evidence,","22":"Those who reject (Truth), among the People of the Book and among the Polytheists, were not going to depart (from their ways) until there should come to them Clear Evidence,-","203":"Those who disbelieve from among the people of the Scripture (Jews and Christians) and Al-Mushrikûn,<sup foot_note=155059>1</sup> were not going to leave (their disbelief) until there came to them clear evidence."},"words":[{"id":122,"position":1,"char_type_name":"word","text_uthmani":"لَمْ","translation":{"text":"Not","language_name":"english"},"transliteration":{"text":"lam","language_name":"english"}},{"id":123,"position":2,"char_type_name":"word","text_uthmani":"يَكُنِ","translation":{"text":"were","language_name":"english"},"transliteration":{"text":"yakuni","language_name":"english"}},{"id":124,"position":3,"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","translation":{"text":"those who","language_name":"english"},"transliteration":{"text":"alladhīna","language_name":"english"}},{"id":125,"position":4,"char_type_name":"word","text_uthmani":"كَفَرُوا۟","translation":{"text":"disbelieved","language_name":"english"},"transliteration":{"text":"kafarū","language_name":"english"}},{"id":126,"position":5,"char_type_name":"word","text_uthmani":"مِنْ","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"min","language_name":"english"}},{"id":127,"position":6,"char_type_name":"word","text_uthmani":"أَهْلِ","translation":{"text":"(the) People","language_name":"english"},"transliteration":{"text":"ahli","language_name":"english"}},{"id":128,"position":7,"char_type_name":"word","text_uthmani":"ٱلْكِتَـٰبِ","translation":{"text":"of the Book","language_name":"english"},"transliteration":{"text":"l-kitābi","language_name":"english"}},{"id":129,"position":8,"char_type_name":"word","text_uthmani":"وَٱلْمُشْرِكِينَ","translation":{"text":"and the polytheists","language_name":"english"},"transliteration":{"text":"wal-mush'rikīna","language_name":"english"}},{"id":130,"position":9,"char_type_name":"word","text_uthmani":"مُنفَكِّينَ","translation":{"text":"to be abandoned","language_name":"english"},"transliteration":{"text":"munfakkīna","language_name":"english"}},{"id":131,"position":10,"char_type_name":"word","text_uthmani":"حَتَّىٰ","translation":{"text":"until","language_name":"english"},"transliteration":{"text":"ḥattā","language_name":"english"}},{"id":132,"position":11,"char_type_name":"word","text_uthmani":"تَأْتِيَهُمُ","translation":{"text":"(there) comes to them","language_name":"english"},"transliteration":{"text":"tatiyahumu","language_name":"english"}},{"id":133,"position":12,"char_type_name":"word","text_uthmani":"ٱلْبَيِّنَةُ","translation":{"text":"the clear evidence","language_name":"english"},"transliteration":{"text":"l-bayinatu","language_name":"english"}}]},{"id":6132,"verse_number":2,"verse_key":"98:2","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":598,"text_uthmani":"رَسُولٌ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًا مُّطَهَّرَةً","trs":{"20":"A Messenger from Allāh, reciting purified<sup foot_note=197791>1</sup> scriptures","85":"a messenger from God, reading out pages [blessed with] purity,","22":"An messenger from Allah, rehearsing scriptures kept pure and holy:","203":"A Messenger (Muhammad صلى الله عليه وسلم) from Allâh, reciting (the Qur’ân) purified pages [purified from Al-Bâtil (falsehood)]."},"words":[{"id":1795,"position":1,"char_type_name":"word","text_uthmani":"رَسُولٌۭ","translation":{"text":"A Messenger","language_name":"english"},"transliteration":{"text":"rasūlun","language_name":"english"}},{"id":1796,"position":2,"char_type_name":"word","text_uthmani":"مِّنَ","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"mina","language_name":"english"}},{"id":1797,"position":3,"char_type_name":"word","text_uthmani":"ٱللَّهِ","translation":{"text":"Allah","language_name":"english"},"transliteration":{"text":"l-lahi","language_name":"english"}},{"id":1798,"position":4,"char_type_name":"word","text_uthmani":"يَتْلُوا۟","translation":{"text":"reciting","language_name":"english"},"transliteration":{"text":"yatlū","language_name":"english"}},{"id":1799,"position":5,"char_type_name":"word","text_uthmani":"صُحُفًۭا","translation":{"text":"pages","language_name":"english"},"transliteration":{"text":"ṣuḥufan","language_name":"english"}},{"id":1800,"position":6,"char_type_name":"word","text_uthmani":"مُّطَهَّرَةًۭ","translation":{"text":"purified","language_name":"english"},"transliteration":{"text":"muṭahharatan","language_name":"english"}}]},{"id":6133,"verse_number":3,"verse_key":"98:3","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":598,"text_uthmani":"فِيهَا كُتُبٌ قَيِّمَةٌ","trs":{"20":"Within which are correct writings [i.e., rulings and laws].","85":"containing true scriptures.","22":"Wherein are laws (or decrees) right and straight.","203":"Wherein are correct and straight laws from Allâh."},"words":[{"id":2907,"position":1,"char_type_name":"word","text_uthmani":"فِيهَا","translation":{"text":"Wherein","language_name":"english"},"transliteration":{"text":"fīhā","language_name":"english"}},{"id":2908,"position":2,"char_type_name":"word","text_uthmani":"كُتُبٌۭ","translation":{"text":"(are) writings","language_name":"english"},"transliteration":{"text":"kutubun","language_name":"english"}},{"id":2909,"position":3,"char_type_name":"word","text_uthmani":"قَيِّمَةٌۭ","translation":{"text":"correct","language_name":"english"},"transliteration":{"text":"qayyimatun","language_name":"english"}}]},{"id":6134,"verse_number":4,"verse_key":"98:4","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":598,"text_uthmani":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ","trs":{"20":"Nor did those who were given the Scripture become divided<sup foot_note=197792>1</sup> until after there had come to them clear evidence.","85":"[Yet] those who were given the Scripture became divided only after they were sent [such] clear evi-dence","22":"Nor did the People of the Book make schisms, until after there came to them Clear Evidence.","203":"And the people of the Scripture (Jews and Christians) differed not until after there came to them clear evidence (i.e. Prophet Muhammad صلى الله عليه وسلم and whatever was revealed to him)."},"words":[{"id":3300,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":3301,"position":2,"char_type_name":"word","text_uthmani":"تَفَرَّقَ","translation":{"text":"became divided","language_name":"english"},"transliteration":{"text":"tafarraqa","language_name":"english"}},{"id":3302,"position":3,"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","translation":{"text":"those who","language_name":"english"},"transliteration":{"text":"alladhīna","language_name":"english"}},{"id":3303,"position":4,"char_type_name":"word","text_uthmani":"أُوتُوا۟","translation":{"text":"were given","language_name":"english"},"transliteration":{"text":"ūtū","language_name":"english"}},{"id":3304,"position":5,"char_type_name":"word","text_uthmani":"ٱلْكِتَـٰبَ","translation":{"text":"the Book","language_name":"english"},"transliteration":{"text":"l-kitāba","language_name":"english"}},{"id":3305,"position":6,"char_type_name":"word","text_uthmani":"إِلَّا","translation":{"text":"until","language_name":"english"},"transliteration":{"text":"illā","language_name":"english"}},{"id":3306,"position":7,"char_type_name":"word","text_uthmani":"مِنۢ","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"min","language_name":"english"}},{"id":3307,"position":8,"char_type_name":"word","text_uthmani":"بَعْدِ","translation":{"text":"after","language_name":"english"},"transliteration":{"text":"baʿdi","language_name":"english"}},{"id":3308,"position":9,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":3309,"position":10,"char_type_name":"word","text_uthmani":"جَآءَتْهُمُ","translation":{"text":"came (to) them","language_name":"english"},"transliteration":{"text":"jāathumu","language_name":"english"}},{"id":3310,"position":11,"char_type_name":"word","text_uthmani":"ٱلْبَيِّنَةُ","translation":{"text":"(of) the clear evidence","language_name":"english"},"transliteration":{"text":"l-bayinatu","language_name":"english"}}]},{"id":6135,"verse_number":5,"verse_key":"98:5","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":598,"text_uthmani":"وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ","trs":{"20":"And they were not commanded except to worship Allāh, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakāh. And that is the correct religion.","85":"though all they are ordered to do is worship God alone, sincerely devoting their religion to Him as people of true faith, keep up the prayer, and pay the prescribed alms, for that is the true religion.","22":"And they have been commanded no more than this: To worship Allah, offering Him sincere devotion, being true (in faith); to establish regular prayer; and to practise regular charity; and that is the Religion Right and Straight.","203":"And they were commanded not, but that they should worship Allâh, and worship none but Him Alone (abstaining from ascribing partners to Him), and perform As-Salât (Iqâmat-as-Salât) and give Zakât, and that is the right religion."},"words":[{"id":4610,"position":1,"char_type_name":"word","text_uthmani":"وَمَآ","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":4611,"position":2,"char_type_name":"word","text_uthmani":"أُمِرُوٓا۟","translation":{"text":"they were commanded","language_name":"english"},"transliteration":{"text":"umirū","language_name":"english"}},{"id":4612,"position":3,"char_type_name":"word","text_uthmani":"إِلَّا","translation":{"text":"except","language_name":"english"},"transliteration":{"text":"illā","language_name":"english"}},{"id":4613,"position":4,"char_type_name":"word","text_uthmani":"لِيَعْبُدُوا۟","translation":{"text":"to worship","language_name":"english"},"transliteration":{"text":"liyaʿbudū","language_name":"english"}},{"id":4614,"position":5,"char_type_name":"word","text_uthmani":"ٱللَّهَ","translation":{"text":"Allah","language_name":"english"},"transliteration":{"text":"l-laha","language_name":"english"}},{"id":4615,"position":6,"char_type_name":"word","text_uthmani":"مُخْلِصِينَ","translation":{"text":"(being) sincere","language_name":"english"},"transliteration":{"text":"mukh'liṣīna","language_name":"english"}},{"id":4616,"position":7,"char_type_name":"word","text_uthmani":"لَهُ","translation":{"text":"to Him","language_name":"english"},"transliteration":{"text":"lahu","language_name":"english"}},{"id":4617,"position":8,"char_type_name":"word","text_uthmani":"ٱلدِّينَ","translation":{"text":"(in) the religion","language_name":"english"},"transliteration":{"text":"l-dīna","language_name":"english"}},{"id":4618,"position":9,"char_type_name":"word","text_uthmani":"حُنَفَآءَ","translation":{"text":"upright","language_name":"english"},"transliteration":{"text":"ḥunafāa","language_name":"english"}},{"id":4619,"position":10,"char_type_name":"word","text_uthmani":"وَيُقِيمُوا۟","translation":{"text":"and to establish","language_name":"english"},"transliteration":{"text":"wayuqīmū","language_name":"english"}},{"id":4620,"position":11,"char_type_name":"word","text_uthmani":"ٱلصَّلَوٰةَ","translation":{"text":"the prayer","language_name":"english"},"transliteration":{"text":"l-ṣalata","language_name":"english"}},{"id":4621,"position":12,"char_type_name":"word","text_uthmani":"وَيُؤْتُوا۟","translation":{"text":"and to give","language_name":"english"},"transliteration":{"text":"wayu'tū","language_name":"english"}},{"id":4622,"position":13,"char_type_name":"word","text_uthmani":"ٱلزَّكَوٰةَ ۚ","translation":{"text":"the zakah","language_name":"english"},"transliteration":{"text":"l-zakata","language_name":"english"}},{"id":4624,"position":14,"char_type_name":"word","text_uthmani":"وَذَٰلِكَ","translation":{"text":"And that","language_name":"english"},"transliteration":{"text":"wadhālika","language_name":"english"}},{"id":4625,"position":15,"char_type_name":"word","text_uthmani":"دِينُ","translation":{"text":"(is the) religion","language_name":"english"},"transliteration":{"text":"dīnu","language_name":"english"}},{"id":4626,"position":16,"char_type_name":"word","text_uthmani":"ٱلْقَيِّمَةِ","translation":{"text":"the correct","language_name":"english"},"transliteration":{"text":"l-qayimati","language_name":"english"}}]},{"id":6136,"verse_number":6,"verse_key":"98:6","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":542,"manzil_number":7,"sajdah_number":null,"page_number":599,"text_uthmani":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ","trs":{"20":"Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.","85":"Those who disbelieve among the People of the Book and the idolaters will have the Fire of Hell, there to remain. They are the worst of creation.","22":"Those who reject (Truth), among the People of the Book and among the Polytheists, will be in Hell-Fire, to dwell therein (for aye). They are the worst of creatures.","203":"Verily, those who disbelieve (in the religion of Islâm, the Qur’ân and Prophet Muhammad صلى الله عليه وسلم) from among the people of the Scripture (Jews and Christians) and Al-Mushrikûn will abide in the Fire of Hell. They are the worst of creatures.<sup foot_note=155060>1</sup>"},"words":[{"id":6766,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":6767,"position":2,"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","translation":{"text":"those who","language_name":"english"},"transliteration":{"text":"alladhīna","language_name":"english"}},{"id":6768,"position":3,"char_type_name":"word","text_uthmani":"كَفَرُوا۟","translation":{"text":"disbelieve","language_name":"english"},"transliteration":{"text":"kafarū","language_name":"english"}},{"id":6769,"position":4,"char_type_name":"word","text_uthmani":"مِنْ","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"min","language_name":"english"}},{"id":6770,"position":5,"char_type_name":"word","text_uthmani":"أَهْلِ","translation":{"text":"(the) People","language_name":"english"},"transliteratio