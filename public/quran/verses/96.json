":"lam","language_name":"english"}},{"id":5431,"position":5,"char_type_name":"word","text_uthmani":"يَعْلَمْ","translation":{"text":"he knew","language_name":"english"},"transliteration":{"text":"yaʿlam","language_name":"english"}}]},{"id":6112,"verse_number":6,"verse_key":"96:6","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":540,"manzil_number":7,"sajdah_number":null,"page_number":597,"text_uthmani":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","trs":{"20":"No! [But] indeed, man transgresses","85":"But man exceeds all bounds","22":"Nay, but man doth transgress all bounds,","203":"Nay! Verily, man does transgress (in disbelief and evil deed)."},"words":[{"id":6676,"position":1,"char_type_name":"word","text_uthmani":"كَلَّآ","translation":{"text":"Nay","language_name":"english"},"transliteration":{"text":"kallā","language_name":"english"}},{"id":6677,"position":2,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":6678,"position":3,"char_type_name":"word","text_uthmani":"ٱلْإِنسَـٰنَ","translation":{"text":"man","language_name":"english"},"transliteration":{"text":"l-insāna","language_name":"english"}},{"id":6679,"position":4,"char_type_name":"word","text_uthmani":"لَيَطْغَىٰٓ","translation":{"text":"surely transgresses","language_name":"english"},"transliteration":{"text":"layaṭghā","language_name":"english"}}]},{"id":6113,"verse_number":7,"verse_key":"96:7","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":540,"manzil_number":7,"sajdah_number":null,"page_number":597,"text_uthmani":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","trs":{"20":"Because he sees himself self-sufficient.","85":"when he thinks he is self-sufficient:","22":"In that he looketh upon himself as self-sufficient.","203":"Because he considers himself self-sufficient."},"words":[{"id":8005,"position":1,"char_type_name":"word","text_uthmani":"أَن","translati