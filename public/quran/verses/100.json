 dawn,<sup foot_note=197799>1</sup>","85":"who make dawn raids,","22":"And push home the charge in the morning,","203":"And scouring to the raid at dawn."},"words":[{"id":3166,"position":1,"char_type_name":"word","text_uthmani":"فَٱلْمُغِيرَٰتِ","translation":{"text":"And the chargers","language_name":"english"},"transliteration":{"text":"fal-mughīrāti","language_name":"english"}},{"id":3167,"position":2,"char_type_name":"word","text_uthmani":"صُبْحًۭا","translation":{"text":"(at) dawn","language_name":"english"},"transliteration":{"text":"ṣub'ḥan","language_name":"english"}}]},{"id":6150,"verse_number":4,"verse_key":"100:4","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":599,"text_uthmani":"فَأَثَرْنَ بِهِۦ نَقْعًا","trs":{"20":"Stirring up thereby [clouds of] dust,","85":"raising a cloud of dust,","22":"And raise the dust in clouds the while,","203":"And raise the dust in clouds the while."},"words":[{"id":4469,"position":1,"char_type_name":"word","text_uthmani":"فَأَثَرْنَ","translation":{"text":"Then raise","language_name":"english"},"transliteration":{"text":"fa-atharna","language_name":"english"}},{"id":4470,"position":2,"char_type_name":"word","text_uthmani":"بِهِۦ","translation":{"text":"thereby","language_name":"english"},"transliteration":{"text":"bihi","language_name":"english"}},{"id":4471,"position":3,"char_type_name":"word","text_uthmani":"نَقْعًۭا","translation":{"text":"dust","language_name":"english"},"transliteration":{"text":"naqʿan","language_name":"english"}}]},{"id":6151,"verse_number":5,"verse_key":"100:5","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":599,"text_uthmani":"فَوَسَطْنَ بِهِۦ جَمْعًا","trs":{"20":"Arriving thereby in the center<sup foot_note=197800>1</sup> collectively,","85":"and plunging into the midst of the enemy,","22":"And penetrate forthwith into the midst (of the foe) en masse;-","203":"And penetrating forthwith as one into the midst (of the foe)."},"words":[{"id":5794,"position":1,"char_type_name":"word","text_uthmani":"فَوَسَطْنَ","translation":{"text":"Then penetrate (in the) center","language_name":"english"},"transliteration":{"text":"fawasaṭna","language_name":"english"}},{"id":5795,"position":2,"char_type_name":"word","text_uthmani":"بِهِۦ","translation":{"text":"thereby","language_name":"english"},"transliteration":{"text":"bihi","language_name":"english"}},{"id":5796,"position":3,"char_type_name":"word","text_uthmani":"جَمْعًا","translation":{"text":"collectively","language_name":"english"},"transliteration":{"text":"jamʿan","language_name":"english"}}]},{"id":6152,"verse_number":6,"verse_key":"100:6","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","trs":{"20":"Indeed mankind, to his Lord, is ungrateful.","85":"man is ungrateful to his Lord––","22":"Truly man is, to his Lord, ungrateful;","203":"Verily, man (disbeliever) is ungrateful to his Lord."},"words":[{"id":7117,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":7118,"position":2,"char_type_name":"word","text_uthmani":"ٱلْإِنسَـٰنَ","translation":{"text":"mankind","language_name":"english"},"transliteration":{"text":"l-insāna","language_name":"english"}},{"id":7119,"position":3,"char_type_name":"word","text_uthmani":"لِرَبِّهِۦ","translation":{"text":"to his Lord","language_name":"english"},"transliteration":{"text":"lirabbihi","language_name":"english"}},{"id":7120,"position":4,"char_type_name":"word","text_uthmani":"لَكَنُودٌۭ","translation":{"text":"(is) surely ungrateful","language_name":"english"},"transliteration":{"text":"lakanūdun","language_name":"english"}}]},{"id":6153,"verse_number":7,"verse_key":"100:7","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","trs":{"20":"And indeed, he is to that a witness.<sup foot_note=197801>1</sup>","85":"and He is witness to this––","22":"And to that (fact) he bears witness (by his deeds);","203":"And to that he bears witness (by his deeds)."},"words":[{"id":8429,"position":1,"char_type_name":"word","text_uthmani":"وَإِنَّهُۥ","translation":{"text":"And indeed, he","language_name":"english"},"transliteration":{"text":"wa-innahu","language_name":"english"}},{"id":8430,"position":2,"char_type_name":"word","text_uthmani":"عَلَىٰ","translation":{"text":"on","language_name":"english"},"transliteration":{"text":"ʿalā","language_name":"english"}},{"id":8431,"position":3,"char_type_name":"word","text_uthmani":"ذَٰلِكَ","translation":{"text":"that","language_name":"english"},"transliteration":{"text":"dhālika","language_name":"english"}},{"id":8432,"position":4,"char_type_name":"word","text_uthmani":"لَشَهِيدٌۭ","translation":{"text":"surely (is) a witness","language_name":"english"},"transliteration":{"text":"lashahīdun","language_name":"english"}}]},{"id":6154,"verse_number":8,"verse_key":"100:8","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","trs":{"20":"And indeed he is, in love of wealth, intense.","85":"he is truly excessive in his love of wealth.","22":"And violent is he in his love of wealth.","203":"And verily, he is violent in the love of wealth."},"words":[{"id":9582,"position":1,"char_type_name":"word","text_uthmani":"وَإِنَّهُۥ","translation":{"text":"And indeed he","language_name":"english"},"transliteration":{"text":"wa-innahu","language_name":"english"}},{"id":9583,"position":2,"char_type_name":"word","text_uthmani":"لِحُبِّ","translation":{"text":"in (the) love","language_name":"english"},"transliteration":{"text":"liḥubbi","language_name":"english"}},{"id":9584,"position":3,"char_type_name":"word","text_uthmani":"ٱلْخَيْرِ","translation":{"text":"(of) wealth","language_name":"english"},"transliteration":{"text":"l-khayri","language_name":"english"}},{"id":9585,"position":4,"char_type_name":"word","text_uthmani":"لَشَدِيدٌ","translation":{"text":"(is) surely intense","language_name":"english"},"transliteration":{"text":"lashadīdun","language_name":"english"}}]},{"id":6155,"verse_number":9,"verse_key":"100:9","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","trs":{"20":"But does he not know that when the contents of the graves are scattered","85":"Does he not know that when the contents of graves burst forth,","22":"Does he not know,- when that which is in the graves is scattered abroad","203":"Knows he not that when the contents of the graves are poured forth (all mankind is resurrected)?"},"words":[{"id":10714,"position":1,"char_type_name":"word","text_uthmani":"۞ أَفَلَا","translation":{"text":"But does not","language_name":"english"},"transliteration":{"text":"afalā","language_name":"english"}},{"id":10715,"position":2,"char_type_name":"word","text_uthmani":"يَعْلَمُ","translation":{"text":"he know","language_name":"english"},"transliteration":{"text":"yaʿlamu","language_name":"english"}},{"id":10716,"position":3,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":10717,"position":4,"char_type_name":"word","text_uthmani":"بُعْثِرَ","translation":{"text":"will be scattered","language_name":"english"},"transliteration":{"text":"buʿ'thira","language_name":"english"}},{"id":10718,"position":5,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":10719,"position":6,"char_type_name":"word","text_uthmani":"فِى","translation":{"text":"(is) in","language_name":"english"},"transliteration":{"text":"fī","language_name":"english"}},{"id":10720,"position":7,"char_type_name":"word","text_uthmani":"ٱلْقُبُورِ","translation":{"text":"the graves","language_name":"english"},"transliteration":{"text":"l-qubūri","language_name":"english"}}]},{"id":6156,"verse_number":10,"verse_key":"100:10","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","trs":{"20":"And that within the breasts is obtained,<sup foot_note=197802>1</sup>","85":"when the secrets of hearts are uncovered, on that Day,","22":"And that which is (locked up) in (human) breasts is made manifest-","203":"And that which is in the breasts (of men) is made known?"},"words":[{"id":11729,"position":1,"char_type_name":"word","text_uthmani":"وَحُصِّلَ","translation":{"text":"And is made apparent","language_name":"english"},"transliteration":{"text":"waḥuṣṣila","language_name":"english"}},{"id":11730,"position":2,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":11731,"position":3,"char_type_name":"word","text_uthmani":"فِى","translation":{"text":"(is) in","language_name":"english"},"transliteration":{"text":"fī","language_name":"english"}},{"id":11732,"position":4,"char_type_name":"word","text_uthmani":"ٱلصُّدُورِ","translation":{"text":"the breasts","language_name":"english"},"transliteration":{"text":"l-ṣudūri","language_name":"english"}}]},{"id":6157,"verse_number":11,"verse_key":"100:11","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":544,"manzil_number":7,"sajdah_number":null,"page_number":600,"text_uthmani":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","trs":{"20":"Indeed, their Lord with them, that Day, is [fully] Aware.<sup foot_note=197803>1</sup>","85":"their Lord will be fully aware of them all?","22":"That their Lord had been Well-acquainted with them, (even to) that Day?","203":"Verily, that Day (i.e. the Day of Resurrection) their Lord will be Well-Acquainted with them (as to their deeds and will reward them for their deeds)."},"words":[{"id":12259,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":12260,"position":2,"char_type_name":"word","text_uthmani":"رَبَّهُم","translation":{"text":"their Lord","language_name":"english"},"transliteration":{"text":"rabbahum","language_name":"english"}},{"id":12261,"position":3,"char_type_name":"word","text_uthmani":"بِهِمْ","translation":{"text":"about them","language_name":"english"},"transliteration":{"text":"bihim","language_name":"english"}},{"id":12262,"position":4,"char_type_name":"word","text_uthmani":"يَوْمَئِذٍۢ","translation":{"text":"that Day","language_name":"english"},"transliteration":{"text":"yawma-idhin","language_name":"english"}},{"id":12263,"position":5,"char_type_name":"word","text_uthmani":"لَّخَبِيرٌۢ","translation":{"text":"(is) surely All-Aware","language_name":"english"},"transliteration":{"text":"lakhabīrun","language_name":"english"}}]}]}