h which rivers flow: That is the great Salvation, (the fulfilment of all desires),","203":"Verily, those who believe and do righteous good deeds, for them will be Gardens under which rivers flow (Paradise). That is the great success."},"words":[{"id":13024,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":13025,"position":2,"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","translation":{"text":"those who","language_name":"english"},"transliteration":{"text":"alladhīna","language_name":"english"}},{"id":13026,"position":3,"char_type_name":"word","text_uthmani":"ءَامَنُوا۟","translation":{"text":"believe","language_name":"english"},"transliteration":{"text":"āmanū","language_name":"english"}},{"id":13027,"position":4,"char_type_name":"word","text_uthmani":"وَعَمِلُوا۟","translation":{"text":"and do","language_name":"english"},"transliteration":{"text":"waʿamilū","language_name":"english"}},{"id":13028,"position":5,"char_type_name":"word","text_uthmani":"ٱلصَّـٰلِحَـٰتِ","translation":{"text":"the righteous deeds","language_name":"english"},"transliteration":{"text":"l-ṣāliḥāti","language_name":"english"}},{"id":13029,"position":6,"char_type_name":"word","text_uthmani":"لَهُمْ","translation":{"text":"for them","language_name":"english"},"transliteration":{"text":"lahum","language_name":"english"}},{"id":13030,"position":7,"char_type_name":"word","text_uthmani":"جَنَّـٰتٌۭ","translation":{"text":"(will be) Gardens","language_name":"english"},"transliteration":{"text":"jannātun","language_name":"english"}},{"id":13031,"position":8,"char_type_name":"word","text_uthmani":"تَجْرِى","translation":{"text":"flow","language_name":"english"},"transliteration":{"text":"tajrī","language_name":"english"}},{"id":13032,"position":9,"char_type_name":"word","text_uthmani":"مِن","translation":{"text":"from","language_name":"english"},"transliteration":