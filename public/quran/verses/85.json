6736,"position":4,"char_type_name":"word","text_uthmani":"قُعُودٌۭ","translation":{"text":"(were) sitting","language_name":"english"},"transliteration":{"text":"quʿūdun","language_name":"english"}}]},{"id":5916,"verse_number":7,"verse_key":"85:7","juz_number":30,"rub_el_hizb_number":236,"hizb_number":59,"ruku_number":529,"manzil_number":7,"sajdah_number":null,"page_number":590,"text_uthmani":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","trs":{"20":"And they, to what they were doing against the believers, were witnesses. <sup foot_note=197741>1</sup>","85":"to watch what they were doing to the believers.","22":"And they witnessed (all) that they were doing against the Believers.","203":"And they witnessed what they were doing against the believers (i.e. burning them)."},"words":[{"id":8074,"position":1,"char_type_name":"word","text_uthmani":"وَهُمْ","translation":{"text":"And they","language_name":"english"},"transliteration":{"text":"wahum","language_name":"english"}},{"id":8075,"position":2,"char_type_name":"word","text_uthmani":"عَلَىٰ","translation":{"text":"over","language_name":"english"},"transliteration":{"text":"ʿalā","language_name":"english"}},{"id":8076,"position":3,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":8077,"position":4,"char_type_name":"word","text_uthmani":"يَفْعَلُونَ","translation":{"text":"they were doing","language_name":"english"},"transliteration":{"text":"yafʿalūna","language_name":"english"}},{"id":8078,"position":5,"char_type_name":"word","text_uthmani":"بِٱلْمُؤْمِنِينَ","translation":{"text":"to the believers","language_name":"english"},"transliteration":{"text":"bil-mu'minīna","language_name":"english"}},{"id":8079,"position":6,"char_type_name":"word","text_uthmani":"شُهُودٌۭ","translation":{"text":"witnesses","language_name":"english"},"transliteration":{"text":"shuhūdun","language_name":"english"}}]},{"id":5917,"verse_number":8,"verse_key":"85:8","juz_number":30,"rub_el_hizb_number":236,"hizb_number":59,"ruku_number":529,"manzil_number":7,"sajdah_number":null,"page_number":590,"text_uthmani":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","trs":{"20":"And they resented them not except because they believed in Allāh, the Exalted in Might, the Praiseworthy,","85":"Their only grievance against them was their faith in God, the Mighty, the Praiseworthy,","22":"And they ill-treated them for no other reason than that they believed in Allah, Exalted in Power, Worthy of all Praise!-","203":"And they had no fault except that they believed in Allâh, the All-Mighty, Worthy of all Praise!"},"words":[{"id":9243,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":9244,"position":2,"char_type_name":"word","text_uthmani":"نَقَمُوا۟","translation":{"text":"they resented","language_name":"english"},"transliteration":{"text":"naqamū","language_name":"english"}},{"id":9245,"position":3,"char_type_name":"word","text_uthmani":"مِنْهُمْ","translation":{"text":"[of] them","language_name":"english"},"transliteration":{"text":"min'hum","language_name":"english"}},{"id":9246,"position":4,"char_type_name":"word","text_uthmani":"إِلَّآ","translation":{"text":"except","language_name":"english"},"transliteration":{"text":"illā","language_name":"english"}},{"id":9247,"position":5,"char_type_name":"word","text_uthmani":"أَن","translation":{"text":"that","language_name":"english"},"transliteration":{"text":"an","language_name":"english"}},{"id":9248,"position":6,"char_type_name":"word","text_uthmani":"يُؤْمِنُوا۟","translation":{"text":"they believed","language_name":"english"},"transliteration":{"text":"yu'minū","language_name":"english"}},{"id":9249,"position":7,"char_type_name":"word","text_uthmani":"بِٱللَّهِ","translation":{"text":"in Allah","language_name":"english"},"transliteration":{"text":"bil-lahi","language_name":"english"}},{"id":9250,"position":8,"char_type_name":"word","text_uthmani":"ٱلْعَزِيزِ","translation":{"text":"the All-Mighty","language_name":"english"},"transliteration":{"text":"l-ʿazīzi","language_name":"english"}},{"id":9251,"position":9,"char_type_name":"word","text_uthmani":"ٱلْحَمِيدِ","translation":{"text":"the Praiseworthy","language_name":"english"},"transliteration":{"text":"l-ḥamīdi","language_name":"english"}}]},{"id":5918,"verse_number":9,"verse_key":"85:9","juz_number":30,"rub_el_hizb_number":236,"hizb_number":59,"ruku_number":529,"manzil_number":7,"sajdah_number":null,"page_number":590,"text_uthmani":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","trs":{"20":"To whom belongs the dominion of the heavens and the earth. And Allāh, over all things, is Witness.<sup foot_note=197742>1</sup>","85":"to whom all control over the heavens and earth belongs: God is witness over all things.","22":"Him to Whom belongs the dominion of the heavens and the earth! And Allah is Witness to all things.","203":"To Whom belongs the dominion of the heavens and the earth! And Allâh is Witness over everything."},"words":[{"id":10438,"position":1,"char_type_name":"word","text_uthmani":"ٱلَّذِى","translation":{"text":"The One Who","language_name":"english"},"transliteration":{"text":"alladhī","language_name":"english"}},{"id":10439,"position":2,"char_type_name":"word","text_uthmani":"لَهُۥ","translation":{"text":"for Him","language_name":"english"},"transliteration":{"text":"lahu","language_name":"english"}},{"id":10440,"position":3,"char_type_name":"word","text_uthmani":"مُلْكُ","translation":{"text":"(is) the dominion","language_name":"english"},"transliteration":{"text":"mul'ku","language_name":"english"}},{"id":10441,"position":4,"char_type_name":"word","text_uthmani":"ٱلسَّمَـٰوَٰتِ","translation":{"text":"(of) the heavens","language_name":"english"},"transliteration":{"text":"l-samāwāti","language_name":"english"}},{"id":10442,"position":5,"char_type_name":"word","text_uthmani":"وَٱلْأَرْضِ ۚ","translation":{"text":"and the earth","language_name":"english"},"transliteration":{"text":"wal-arḍi","language_name":"english"}},{"id":10444,"position":6,"char_type_name":"word","text_uthmani":"وَٱللَّهُ","translation":{"text":"and Allah","language_name":"english"},"transliteration":{"text":"wal-lahu","language_name":"english"}},{"id":10445,"position":7,"char_type_name":"word","text_uthmani":"عَلَىٰ","translation":{"text":"on","language_name":"english"},"transliteration":{"text":"ʿalā","language_name":"english"}},{"id":10446,"position":8,"char_type_name":"word","text_uthmani":"كُلِّ","translation":{"text":"every","language_name":"english"},"transliteration":{"text":"kulli","language_name":"english"}},{"id":10447,"position":9,"char_type_name":"word","text_uthmani":"شَىْءٍۢ","translation":{"text":"thing","language_name":"english"},"transliteration":{"text":"shayin","language_name":"english"}},{"id":10448,"position":10,"char_type_name":"word","text_uthmani":"شَهِيدٌ","translation":{"text":"(is) a Witness","language_name":"english"},"transliteration":{"text":"shahīdun","language_name":"english"}}]},{"id":5919,"verse_number":10,"verse_key":"85:10","juz_number":30,"rub_el_hizb_number":236,"hizb_number":59,"ruku_number":529,"manzil_number":7,"sajdah_number":null,"page_number":590,"text_uthmani":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","trs":{"20":"Indeed, those who have tortured<sup foot_note=197743>1</sup> the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.","85":"For those who persecute believing men and women, and do not repent afterwards, there will be the torment of Hell and burning.","22":"Those who persecute (or draw into temptation) the Believers, men and women, and do not turn in repentance, will have the Penalty of Hell: They will have the Penalty of the Burning Fire.","203":"Verily, those who put into trial the believing men and believing women (by torturing them and burning them), and then do not turn in repentance (to Allâh), then they will have the torment of Hell, and they will have the punishment of the burning Fire."},"words":[{"id":10953,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":10954,"position":2,"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","translation":{"text":"those who","language_name":"english"},"transliteration":{"text":"alladhīna","language_name":"english"}},{"id":10955,"position":3,"char_type_name":"word","text_uthmani":"فَتَنُوا۟","translation":{"text":"persecuted","language_name":"english"},"transliteration":{"text":"fatanū","language_name":"english"}},{"id":10956,"position":4,"char_type_name":"word","text_uthmani":"ٱلْمُؤْمِنِينَ","translation":{"text":"the believing men","language_name":"english"},"transliteration":{"text":"l-mu'minīna","language_name":"english"}},{"id":10957,"position":5,"char_type_name":"word","text_uthmani":"وَٱلْمُؤْمِنَـٰتِ","translation":{"text":"and the believing women","language_name":"english"},"transliteration":{"text":"wal-mu'mināti","language_name":"english"}},{"id":10958,"position":6,"char_type_name":"word","text_uthmani":"ثُمَّ","translation":{"text":"then","language_name":"english"},"transliteration":{"text":"thumma","language_name":"english"}},{"id":10959,"position":7,"char_type_name":"word","text_uthmani":"لَمْ","translation":{"text":"not","language_name":"english"},"transliteration":{"text":"lam","language_name":"english"}},{"id":10960,"position":8,"char_type_name":"word","text_uthmani":"يَتُوبُوا۟","translation":{"text":"they repented","language_name":"english"},"