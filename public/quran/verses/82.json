guage_name":"english"}}]},{"id":5832,"verse_number":3,"verse_key":"82:3","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","trs":{"20":"And when the seas are erupted","85":"when the seas burst forth,","22":"When the Oceans are suffered to burst forth;","203":"And when the seas are burst forth."},"words":[{"id":2849,"position":1,"char_type_name":"word","text_uthmani":"وَإِذَا","translation":{"text":"And when","language_name":"english"},"transliteration":{"text":"wa-idhā","language_name":"english"}},{"id":2850,"position":2,"char_type_name":"word","text_uthmani":"ٱلْبِحَارُ","translation":{"text":"the seas","language_name":"english"},"transliteration":{"text":"l-biḥāru","language_name":"english"}},{"id":2851,"position":3,"char_type_name":"word","text_uthmani":"فُجِّرَتْ","translation":{"text":"are made to gush forth","language_name":"english"},"transliteration":{"text":"fujjirat","language_name":"english"}}]},{"id":5833,"verse_number":4,"verse_key":"82:4","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","trs":{"20":"And when the [contents of] graves are scattered [i.e., exposed],","85":"when graves turn inside out:","22":"And when the Graves are turned upside down;-","203":"And when the graves are turned upside down (and bring out their contents)"},"words":[{"id":4214,"position":1,"char_type_name":"word","text_uthmani":"وَإِذَا","translation":{"text":"And when","language_name":"english"},"transliteration":{"text":"wa-idhā","language_name":"english"}},{"id":4215,"position":2,"char_type_name":"word","text_uthmani":"ٱلْقُبُورُ","translation":{"text":"the graves","language_name":"english"},"transliteration":{"text":"l-qubūru","language_name":"english"}},{"id":4216,"position":3,"char_type_name":"word","text_uthmani":"بُعْثِرَتْ","translation":{"text":"are overturned","language_name":"english"},"transliteration":{"text":"buʿ'thirat","language_name":"english"}}]},{"id":5834,"verse_number":5,"verse_key":"82:5","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","trs":{"20":"A soul will [then] know what it has put forth and kept back.","85":"each soul will know what it has done and what it has left undone.","22":"(Then) shall each soul know what it hath sent forward and (what it hath) kept back.","203":"(Then) a person will know what he has sent forward and (what he has) left behind (of good or bad deeds)."},"words":[{"id":5479,"position":1,"char_type_name":"word","text_uthmani":"عَلِمَتْ","translation":{"text":"Will know","language_name":"english"},"transliteration":{"text":"ʿalimat","language_name":"english"}},{"id":5480,"position":2,"char_type_name":"word","text_uthmani":"نَفْسٌۭ","translation":{"text":"a soul","language_name":"english"},"transliteration":{"text":"nafsun","language_name":"english"}},{"id":5481,"position":3,"char_type_name":"word","text_uthmani":"مَّا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":5482,"position":4,"char_type_name":"word","text_uthmani":"قَدَّمَتْ","translation":{"text":"it has sent forth","language_name":"english"},"transliteration":{"text":"qaddamat","language_name":"english"}},{"id":5483,"position":5,"char_type_name":"word","text_uthmani":"وَأَخَّرَتْ","translation":{"text":"and left behind","language_name":"english"},"transliteration":{"text":"wa-akharat","language_name":"english"}}]},{"id":5835,"verse_number":6,"verse_key":"82:6","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","trs":{"20":"O mankind, what has deceived you concerning your Lord, the Generous,","85":"Mankind, what has lured you away from God,","22":"O man! What has seduced thee from thy Lord Most Beneficent?-","203":"O man! What has made you careless about your Lord, the Most Generous?"},"words":[{"id":6707,"position":1,"char_type_name":"word","text_uthmani":"يَـٰٓأَيُّهَا","translation":{"text":"O","language_name":"english"},"transliteration":{"text":"yāayyuhā","language_name":"english"}},{"id":6708,"position":2,"char_type_name":"word","text_uthmani":"ٱلْإِنسَـٰنُ","translation":{"text":"man","language_name":"english"},"transliteration":{"text":"l-insānu","language_name":"english"}},{"id":6709,"position":3,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"What","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":6710,"position":4,"char_type_name":"word","text_uthmani":"غَرَّكَ","translation":{"text":"has deceived you","language_name":"english"},"transliteration":{"text":"gharraka","language_name":"english"}},{"id":6711,"position":5,"char_type_name":"word","text_uthmani":"بِرَبِّكَ","translation":{"text":"concerning your Lord","language_name":"english"},"transliteration":{"text":"birabbika","language_name":"english"}},{"id":6712,"position":6,"char_type_name":"word","text_uthmani":"ٱلْكَرِيمِ","translation":{"text":"the Most Noble","language_name":"english"},"transliteration":{"text":"l-karīmi","language_name":"english"}}]},{"id":5836,"verse_number":7,"verse_key":"82:7","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","trs":{"20":"Who created you, proportioned you, and balanced you?","85":"your generous Lord, who created you, shaped you, proportioned you,","22":"Him Who created thee. Fashioned thee in due proportion, and gave thee a just bias;","203":"Who created you, fashioned you perfectly, and gave you due proportion."},"words":[{"id":8056,"position":1,"char_type_name":"word","text_uthmani":"ٱلَّذِى","translation":{"text":"Who","language_name":"english"},"transliteration":{"text":"alladhī","language_name":"english"}},{"id":8057,"position":2,"char_type_name":"word","text_uthmani":"خَلَقَكَ","translation":{"text":"created you","language_name":"english"},"transliteration":{"text":"khalaqaka","language_name":"english"}},{"id":8058,"position":3,"char_type_name":"word","text_uthmani":"فَسَوَّىٰكَ","translation":{"text":"then fashioned you","language_name":"english"},"transliteration":{"text":"fasawwāka","language_name":"english"}},{"id":8059,"position":4,"char_type_name":"word","text_uthmani":"فَعَدَلَكَ","translation":{"text":"then balanced you","language_name":"english"},"transliteration":{"text":"faʿadalaka","language_name":"english"}}]},{"id":5837,"verse_number":8,"verse_key":"82:8","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","trs":{"20":"In whatever form He willed has He assembled you.","85":"in whatever form He chose?","22":"In whatever Form He wills, does He put thee together.","203":"In whatever form He willed, He put you together."},"words":[{"id":9226,"position":1,"char_type_name":"word","text_uthmani":"فِىٓ","translation":{"text":"In","language_name":"english"},"transliteration":{"text":"fī","language_name":"english"}},{"id":9227,"position":2,"char_type_name":"word","text_uthmani":"أَىِّ","translation":{"text":"whatever","language_name":"english"},"transliteration":{"text":"ayyi","language_name":"english"}},{"id":9228,"position":3,"char_type_name":"word","text_uthmani":"صُورَةٍۢ","translation":{"text":"form","language_name":"english"},"transliteration":{"text":"ṣūratin","language_name":"english"}},{"id":9229,"position":4,"char_type_name":"word","text_uthmani":"مَّا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":9230,"position":5,"char_type_name":"word","text_uthmani":"شَآءَ","translation":{"text":"He willed","language_name":"english"},"transliteration":{"text":"shāa","language_name":"english"}},{"id":9231,"position":6,"char_type_name":"word","text_uthmani":"رَكَّبَكَ","translation":{"text":"He assembled you","language_name":"english"},"transliteration":{"text":"rakkabaka","language_name":"english"}}]},{"id":5838,"verse_number":9,"verse_key":"82:9","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","trs":{"20":"No! But you deny the Recompense.","85":"Yet you still take the Judgement to be a lie!","22":"Nay! But ye do reject Right and Judgment!","203":"Nay! But you deny Ad-Dîn (i.e. the Day of Recompense)."},"words":[{"id":10425,"position":1,"char_type_name":"word","text_uthmani":"كَلَّا","translation":{"text":"Nay","language_name":"english"},"transliteration":{"text":"kallā","language_name":"english"}},{"id":10426,"position":2,"char_type_name":"word","text_uthmani":"بَلْ","translation":{"text":"But","language_name":"english"},"transliteration":{"text":"bal","language_name":"english"}},{"id":10427,"position":3,"char_type_name":"word","text_uthmani":"تُكَذِّبُونَ","translation":{"text":"you deny","language_name":"english"},"transliteration":{"text":"tukadhibūna","language_name":"english"}},{"id":10428,"position":4,"char_type_name":"word","text_uthmani":"بِٱلدِّينِ","translation":{"text":"the Judgment","language_name":"english"},"transliteration":{"text":"bil-dīni","language_name":"english"}}]},{"id":5839,"verse_number":10,"verse_key":"82:10","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","trs":{"20":"And indeed, [appointed] over you are keepers,<sup foot_note=197724>1</sup>","85":"Over you stand","22":"But verily over you (are appointed angels) to protect you,-","203":"But verily, over you (are appointed angels in charge of mankind) to watch you,<sup foot_note=155035>1</sup>"},"words":[{"id":11831,"position":1,"char_type_name":"word","text_uthmani":"وَإِنَّ","translation":{"text":"And indeed","language_name":"english"},"transliteration":{"text":"wa-inna","language_name":"english"}},{"id":11832,"position":2,"char_type_name":"word","text_uthmani":"عَلَيْكُمْ","translation":{"text":"over you","language_name":"english"},"transliteration":{"text":"ʿalaykum","language_name":"english"}},{"id":11833,"position":3,"char_type_name":"word","text_uthmani":"لَحَـٰفِظِينَ","translation":{"text":"(are) surely guardians","language_name":"english"},"transliteration":{"text":"laḥāfiẓīna","language_name":"english"}}]},{"id":5840,"verse_number":11,"verse_key":"82:11","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"كِرَامًا كَـٰتِبِينَ","trs":{"20":"Noble and recording;","85":"watchers, noble recorders","22":"Kind and honourable,- Writing down (your deeds):","203":"Kirâman (Honourable) Kâtibîn writing down (your deeds),<sup foot_note=155036>1</sup>"},"words":[{"id":13006,"position":1,"char_type_name":"word","text_uthmani":"كِرَامًۭا","translation":{"text":"Noble","language_name":"english"},"transliteration":{"text":"kirāman","language_name":"english"}},{"id":13007,"position":2,"char_type_name":"word","text_uthmani":"كَـٰتِبِينَ","translation":{"text":"recording","language_name":"english"},"transliteration":{"text":"kātibīna","language_name":"english"}}]},{"id":5841,"verse_number":12,"verse_key":"82:12","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"يَعْلَمُونَ مَا تَفْعَلُونَ","trs":{"20":"They know whatever you do.","85":"who know what you do:","22":"They know (and understand) all that ye do.","203":"They know all that you do."},"words":[{"id":14263,"position":1,"char_type_name":"word","text_uthmani":"يَعْلَمُونَ","translation":{"text":"They know","language_name":"english"},"transliteration":{"text":"yaʿlamūna","language_name":"english"}},{"id":14264,"position":2,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"whatever","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":14265,"position":3,"char_type_name":"word","text_uthmani":"تَفْعَلُونَ","translation":{"text":"you do","language_name":"english"},"transliteration":{"text":"tafʿalūna","language_name":"english"}}]},{"id":5842,"verse_number":13,"verse_key":"82:13","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","trs":{"20":"Indeed, the righteous will be in pleasure,","85":"the good will live in bliss,","22":"As for the Righteous, they will be in bliss;","203":"Verily, the Abrâr (the pious believers of Islamic Monotheism) will be in Delight (Paradise);"},"words":[{"id":15378,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":15379,"position":2,"char_type_name":"word","text_uthmani":"ٱلْأَبْرَارَ","translation":{"text":"the righteous","language_name":"english"},"transliteration":{"text":"l-abrāra","language_name":"english"}},{"id":15380,"position":3,"char_type_name":"word","text_uthmani":"لَفِى","translation":{"text":"(will be) surely in","language_name":"english"},"transliteration":{"text":"lafī","language_name":"english"}},{"id":15381,"position":4,"char_type_name":"word","text_uthmani":"نَعِيمٍۢ","translation":{"text":"bliss","language_name":"english"},"transliteration":{"text":"naʿīmin","language_name":"english"}}]},{"id":5843,"verse_number":14,"verse_key":"82:14","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","trs":{"20":"And indeed, the wicked will be in Hellfire.","85":"and the wicked will burn in the Fire.","22":"And the Wicked - they will be in the Fire,","203":"And verily, the Fujjâr (the wicked, disbelievers, polytheists, sinners and evil-doers) will be in the blazing Fire (Hell),"},"words":[{"id":16432,"position":1,"char_type_name":"word","text_uthmani":"وَإِنَّ","translation":{"text":"And indeed","language_name":"english"},"transliteration":{"text":"wa-inna","language_name":"english"}},{"id":16433,"position":2,"char_type_name":"word","text_uthmani":"ٱلْفُجَّارَ","translation":{"text":"the wicked","language_name":"english"},"transliteration":{"text":"l-fujāra","language_name":"english"}},{"id":16434,"position":3,"char_type_name":"word","text_uthmani":"لَفِى","translation":{"text":"(will be) surely in","language_name":"english"},"transliteration":{"text":"lafī","language_name":"english"}},{"id":16435,"position":4,"char_type_name":"word","text_uthmani":"جَحِيمٍۢ","translation":{"text":"Hellfire","language_name":"english"},"transliteration":{"text":"jaḥīmin","language_name":"english"}}]},{"id":5844,"verse_number":15,"verse_key":"82:15","juz_number":30,"rub_el_hizb_number":235,"hizb_number":59,"ruku_number":526,"manzil_number":7,"sajdah_number":null,"page_number":587,"text_uthmani":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","trs":{"20":"They will [enter to] burn therein on the Day of Recompense,","85":"They will enter it on the Day of Judgement","22":"Which they will enter on the Day of Judgment,","203":"Therein they will enter, and taste its burning flame on the Day of Recompense,"},"words":[{"id":17585,"position":1,"char_type_name":"word","text_uthmani":"يَصْلَوْنَهَا","translation":{"text":"They will burn (in