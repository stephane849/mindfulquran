it is said to them, \"Come, the Messenger of Allah will pray for your forgiveness\", they turn aside their heads, and thou wouldst see them turning away their faces in arrogance.","203":"And when it is said to them: \"Come, so that the Messenger of Allâh may ask forgiveness from Allâh for you,\" they twist their heads, and you would see them turning away their faces in pride.<sup foot_note=154982>1</sup>"},"words":[{"id":5096,"position":1,"char_type_name":"word","text_uthmani":"وَإِذَا","translation":{"text":"And when","language_name":"english"},"transliteration":{"text":"wa-idhā","language_name":"english"}},{"id":5097,"position":2,"char_type_name":"word","text_uthmani":"قِيلَ","translation":{"text":"it is said","language_name":"english"},"transliteration":{"text":"qīla","language_name":"english"}},{"id":5098,"position":3,"char_type_name":"word","text_uthmani":"لَهُمْ","translation":{"text":"to them","language_name":"english"},"transliteration":{"text":"lahum","language_name":"english"}},{"id":5099,"position":4,"char_type_name":"word","text_uthmani":"تَعَالَوْا۟","translation":{"text":"Come","language_name":"english"},"transliteration":{"text":"taʿālaw","language_name":"english"}},{"id":5100,"position":5,"char_type_name":"word","text_uthmani":"يَسْتَغْفِرْ","translation":{"text":"will ask forgiveness","language_name":"english"},"transliteration":{"text":"yastaghfir","language_name":"english"}},{"id":5101,"position":6,"char_type_name":"word","text_uthmani":"لَكُمْ","translation":{"text":"for you","language_name":"english"},"transliteration":{"text":"lakum","language_name":"english"}},{"id":5102,"position":7,"char_type_name":"word","text_uthmani":"رَسُولُ","translation":{"text":"(the) Messenger","language_name":"english"},"transliteration":{"text":"rasūlu","language_name":"english"}},{"id":5103,"position":8,"char_type_name":"word","text_uthmani":"ٱللَّهِ","translation":{"text":"(of) Allah","language_name":"english"},"transliteration":{"text":"l-lahi","language_name":"