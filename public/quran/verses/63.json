glish"},"transliteration":{"text":"aymānahum","language_name":"english"}},{"id":1367,"position":3,"char_type_name":"word","text_uthmani":"جُنَّةًۭ","translation":{"text":"(as) a cover","language_name":"english"},"transliteration":{"text":"junnatan","language_name":"english"}},{"id":1368,"position":4,"char_type_name":"word","text_uthmani":"فَصَدُّوا۟","translation":{"text":"so they turn away","language_name":"english"},"transliteration":{"text":"faṣaddū","language_name":"english"}},{"id":1369,"position":5,"char_type_name":"word","text_uthmani":"عَن","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"ʿan","language_name":"english"}},{"id":1370,"position":6,"char_type_name":"word","text_uthmani":"سَبِيلِ","translation":{"text":"(the) Way","language_name":"english"},"transliteration":{"text":"sabīli","language_name":"english"}},{"id":1371,"position":7,"char_type_name":"word","text_uthmani":"ٱللَّهِ ۚ","translation":{"text":"(of) Allah","language_name":"english"},"transliteration":{"text":"l-lahi","language_name":"english"}},{"id":1373,"position":8,"char_type_name":"word","text_uthmani":"إِنَّهُمْ","translation":{"text":"Indeed, [they]","language_name":"english"},"transliteration":{"text":"innahum","language_name":"english"}},{"id":1374,"position":9,"char_type_name":"word","text_uthmani":"سَآءَ","translation":{"text":"evil is","language_name":"english"},"transliteration":{"text":"sāa","language_name":"english"}},{"id":1375,"position":10,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":1376,"position":11,"char_type_name":"word","text_uthmani":"كَانُوا۟","translation":{"text":"they used to","language_name":"english"},"transliteration":{"text":"kānū","language_name":"english"}},{"id":1377,"position":12,"char_type_name":"word","text_uthmani":"يَعْمَلُونَ","translation":{"text":"do","language_name":"english"},"transliteration":{"text":"yaʿmalūna","language_name":"english"}}]},{"id":5191,"verse_number":3,"verse_key":"63:3","juz_number":28,"rub_el_hizb_number":221,"hizb_number":56,"ruku_number":490,"manzil_number":7,"sajdah_number":null,"page_number":554,"text_uthmani":"ذَٰلِكَ بِأَنَّهُمْ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ","trs":{"20":"That is because they believed, and then they disbelieved; so their hearts were sealed over, and they do not understand.","85":"because they professed faith and then rejected it, so their hearts have been sealed and they do not understand.","22":"That is because they believed, then they rejected Faith: So a seal was set on their hearts: therefore they understand not.","203":"That is because they believed, and then disbelieved; therefore their hearts are sealed, so they understand not."},"words":[{"id":2426,"position":1,"char_type_name":"word","text_uthmani":"ذَٰلِكَ","translation":{"text":"That","language_name":"english"},"transliteration":{"text":"dhālika","language_name":"english"}},{"id":2427,"position":2,"char_type_name":"word","text_uthmani":"بِأَنَّهُمْ","translation":{"text":"(is) because","language_name":"english"},"transliteration":{"text":"bi-annahum","language_name":"english"}},{"id":2428,"position":3,"char_type_name":"word","text_uthmani":"ءَامَنُوا۟","translation":{"text":"they believed","language_name":"english"},"transliteration":{"text":"āmanū","language_name":"english"}},{"id":2429,"position":4,"char_type_name":"word","text_uthmani":"ثُمَّ","translation":{"text":"then","language_name":"english"},"transliteration":{"text":"thumma","language_name":"english"}},{"id":2430,"position":5,"char_type_name":"word","text_uthmani":"كَفَرُوا۟","translation":{"text":"they disbelieved","language_name":"english"},"transliteration":{"text":"kafarū","language_name":"english"}},{"id":2431,"position":6,"char_type_name":"word","text_uthmani":"فَطُبِعَ","translation":{"text":"so were sealed","language_name":"english"},"transliteration":{"text":"faṭubiʿa","language_name":"english"}},{"id":2432,"position":7,"char_type_name":"word","text_uthmani":"عَلَىٰ","translation":{"text":"[upon]","language_name":"english"},"transliteration":{"text":"ʿalā","language_name":"english"}},{"id":2433,"position":8,"char_type_name":"word","text_uthmani":"قُلُوبِهِمْ","translation":{"text":"their hearts","language_name":"english"},"transliteration":{"text":"qulūbihim","language_name":"english"}},{"id":2434,"position":9,"char_type_name":"word","text_uthmani":"فَهُمْ","translation":{"text":"so they","language_name":"english"},"transliteration":{"text":"fahum","language_name":"english"}},{"id":2435,"position":10,"char_type_name":"word","text_uthmani":"لَا","translation":{"text":"(do) not","language_name":"english"},"transliteration":{"text":"lā","language_name":"english"}},{"id":2436,"position":11,"char_type_name":"word","text_uthmani":"يَفْقَهُونَ","translation":{"text":"understand","language_name":"english"},"transliteration":{"text":"yafqahūna","language_name":"english"}}]},{"id":5192,"verse_number":4,"verse_key":"63:4","juz_number":28,"rub_el_hizb_number":222,"hizb_number":56,"ruku_number":490,"manzil_number":7,"sajdah_number":null,"page_number":554,"text_uthmani":"۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟ تَسْمَعْ لِقَوْلِهِمْ ۖ كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ ۖ يَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ يُؤْفَكُونَ","trs":{"20":"And when you see them, their forms please you, and if they speak, you listen to their speech. [They are] as if they were pieces of wood propped up<sup foot_note=197557>1</sup> - they think that every shout is against them. They are the enemy, so beware of them. May Allāh destroy them; how are they deluded?","85":"When you see them [Prophet], their outward appearance pleases you; when they speak, you listen to what they say. But they are like propped-up tim-bers––they think every cry they hear is against them––and they are the enemy. Beware of them. May God confound them! How devious they are!","22":"When thou lookest at them, their exteriors please thee; and when they speak, thou listenest to their words. They are as (worthless as hollow) pieces of timber propped up, (unable to stand on their own). They think that every cry is against them. They are the enemies; so beware of them. The curse of Allah be on them! How are they deluded (away from the Truth)!","203":"And when you look at them, their bodies please you; and when they speak, you listen to their words. They are as blocks of wood propped up. They think that every cry is against them. They are the enemies, so beware of them. May Allâh curse them! How are they denying (or deviating from) the Right Path?"},"words":[{"id":3822,"position":1,"char_type_name":"word","text_uthmani":"۞ وَإِذَا","translation":{"text":"And when","language_name":"english"},"transliteration":{"text":"wa-idhā","language_name":"english"}},{"id":3823,"position":2,"char_type_name":"word","text_uthmani":"رَأَيْتَهُمْ","translation":{"text":"you see them","language_name":"english"},"transliteration":{"text":"ra-aytahum","language_name":"english"}},{"id":3824,"position":3,"char_type_name":"word","text_uthmani":"تُعْجِبُكَ","translation":{"text":"pleases you","language_name":"english"},"transliteration":{"text":"tuʿ'jibuka","language_name":"english"}},{"id":3825,"position":4,"char_type_name":"word","text_uthmani":"أَجْسَامُهُمْ ۖ","translation":{"text":"their bodies","language_name":"english"},"transliteration":{"text":"ajsāmuhum","language_name":"english"}},{"id":3827,"position":5,"char_type_name":"word","text_uthmani":"وَإِن","translation":{"text":"and if","language_name":"english"},"transliteration":{"text":"wa-in","language_name":"english"}},{"id":3828,"position":6,"char_type_name":"word","text_uthmani":"يَقُولُوا۟","translation":{"text":"they speak","language_name":"english"},"transliteration":{"text":"yaqūlū","language_name":"english"}},{"id":3829,"position":7,"char_type_name":"word","text_uthmani":"تَسْمَعْ","translation":{"text":"you listen","language_name":"english"},"transliteration":{"text":"tasmaʿ","language_name":"english"}},{"id":3830,"position":8,"char_type_name":"word","text_uthmani":"لِقَوْلِهِمْ ۖ","translation":{"text":"to their speech","language_name":"english"},"transliteration":{"text":"liqawlihim","language_name":"english"}},{"id":3832,"position":9,"char_type_name":"word","text_uthmani":"كَأَنَّهُمْ","translation":{"text":"as if they (were)","language_name":"english"},"transliteration":{"text":"ka-annahum","language_name":"english"}},{"id":3833,"position":10,"char_type_name":"word","text_uthmani":"خُشُبٌۭ","translation":{"text":"pieces of wood","language_name":"english"},"transliteration":{"text":"khushubun","language_name":"english"}},{"id":3834,"position":11,"char_type_name":"word","text_uthmani":"مُّسَنَّدَةٌۭ ۖ","translation":{"text":"propped up","language_name":"english"},"transliteration":{"text":"musannadatun","language_name":"english"}},{"id":3836,"position":12,"char_type_name":"word","text_uthmani":"يَحْسَبُونَ","translation":{"text":"They think","language_name":"english"},"transliteration":{"text":"yaḥsabūna","language_name":"english"}},{"id":3837,"position":13,"char_type_name":"word","text_uthmani":"كُلَّ","translation":{"text":"every","language_name":"english"},"transliteration":{"text":"kulla","language_name":"english"}},{"id":3838,"position":14,"char_type_name":"word","text_uthmani":"صَيْحَةٍ","translation":{"text":"shout","language_name":"english"},"transliteration":{"text":"ṣayḥatin","language_name":"english"}},{"id":3839,"position":15,"char_type_name":"word","text_uthmani":"عَلَيْهِمْ ۚ","translation":{"text":"(is) against them","language_name":"english"},"transliteration":{"text":"ʿalayhim","language_name":"english"}},{"id":3841,"position":16,"char_type_name":"word","text_uthmani":"هُمُ","translation":{"text":"They","language_name":"english"},"transliterati