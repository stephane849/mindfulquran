{"verses":[{"id":6059,"verse_number":1,"verse_key":"92:1","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","trs":{"20":"By the night when it covers<sup foot_note=197775>1</sup>","85":"By the enshrouding night,","22":"By the Night as it conceals (the light);","203":"By the night as it envelops."},"words":[{"id":222,"position":1,"char_type_name":"word","text_uthmani":"وَٱلَّيْلِ","translation":{"text":"By the night","language_name":"english"},"transliteration":{"text":"wa-al-layli","language_name":"english"}},{"id":223,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":224,"position":3,"char_type_name":"word","text_uthmani":"يَغْشَىٰ","translation":{"text":"it covers","language_name":"english"},"transliteration":{"text":"yaghshā","language_name":"english"}}]},{"id":6060,"verse_number":2,"verse_key":"92:2","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","trs":{"20":"And [by] the day when it appears","85":"by the radiant day,","22":"By the Day as it appears in glory;","203":"By the day as it appears in brightness."},"words":[{"id":1785,"position":1,"char_type_name":"word","text_uthmani":"وَٱلنَّهَارِ","translation":{"text":"And the day","language_name":"english"},"transliteration":{"text":"wal-nahāri","language_name":"english"}},{"id":1786,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":1787,"position":3,"char_type_name":"word","text_uthmani":"تَجَلَّىٰ","translation":{"text":"it shines in brightness","language_name":"english"},"transliteration":{"text":"tajallā","language_name":"english"}}]},{"id":6061,"verse_number":3,"verse_key":"92:3","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","trs":{"20":"And [by] He who created the male and female,","85":"by His creation of male and female!","22":"By (the mystery of) the creation of male and female;-","203":"By Him Who created male and female."},"words":[{"id":2121,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"And He Who","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":2122,"position":2,"char_type_name":"word","text_uthmani":"خَلَقَ","translation":{"text":"created","language_name":"english"},"transliteration":{"text":"khalaqa","language_name":"english"}},{"id":2123,"position":3,"char_type_name":"word","text_uthmani":"ٱلذَّكَرَ","translation":{"text":"the male","language_name":"english"},"transliteration":{"text":"l-dhakara","language_name":"english"}},{"id":2124,"position":4,"char_type_name":"word","text_uthmani":"وَٱلْأُنثَىٰٓ","translation":{"text":"and the female","language_name":"english"},"transliteration":{"text":"wal-unthā","language_name":"english"}}]},{"id":6062,"verse_number":4,"verse_key":"92:4","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","trs":{"20":"Indeed, your efforts are diverse.","85":"The ways you take differ greatly.","22":"Verily, (the ends) ye strive for are diverse.","203":"Certainly, your efforts and deeds are diverse (different in aims and purposes);"},"words":[{"id":3404,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":3405,"position":2,"char_type_name":"word","text_uthmani":"سَعْيَكُمْ","translation":{"text":"your efforts","language_name":"english"},"transliteration":{"text":"saʿyakum","language_name":"english"}},{"id":3406,"position":3,"char_type_name":"word","text_uthmani":"لَشَتَّىٰ","translation":{"text":"(are) surely diverse","language_name":"english"},"transliteration":{"text":"lashattā","language_name":"english"}}]},{"id":6063,"verse_number":5,"verse_key":"92:5","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","trs":{"20":"As for he who gives and fears Allāh","85":"There is the one who gives, who is mindful of God,","22":"So he who gives (in charity) and fears (Allah),","203":"As for him who gives (in charity) and keeps his duty to Allâh and fears Him,"},"words":[{"id":4746,"position":1,"char_type_name":"word","text_uthmani":"فَأَمَّا","translation":{"text":"Then as for","language_name":"english"},"transliteration":{"text":"fa-ammā","language_name":"english"}},{"id":4747,"position":2,"char_type_name":"word","text_uthmani":"مَنْ","translation":{"text":"(him) who","language_name":"english"},"transliteration":{"text":"man","language_name":"english"}},{"id":4748,"position":3,"char_type_name":"word","text_uthmani":"أَعْطَىٰ","translation":{"text":"gives","language_name":"english"},"transliteration":{"text":"aʿṭā","language_name":"english"}},{"id":4749,"position":4,"char_type_name":"word","text_uthmani":"وَٱتَّقَىٰ","translation":{"text":"and fears","language_name":"english"},"transliteration":{"text":"wa-ittaqā","language_name":"english"}}]},{"id":6064,"verse_number":6,"verse_key":"92:6","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَصَدَّقَ بِٱلْحُسْنَىٰ","trs":{"20":"And believes in the best [reward],","85":"who testifies to goodness––","22":"And (in all sincerity) testifies to the best,-","203":"And believes in Al-Husnâ.<sup foot_note=155053>1</sup>"},"words":[{"id":5977,"position":1,"char_type_name":"word","text_uthmani":"وَصَدَّقَ","translation":{"text":"And believes","language_name":"english"},"transliteration":{"text":"waṣaddaqa","language_name":"english"}},{"id":5978,"position":2,"char_type_name":"word","text_uthmani":"بِٱلْحُسْنَىٰ","translation":{"text":"in the best","language_name":"english"},"transliteration":{"text":"bil-ḥus'nā","language_name":"english"}}]},{"id":6065,"verse_number":7,"verse_key":"92:7","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","trs":{"20":"We will ease him toward ease.","85":"We shall smooth his way towards ease.","22":"We will indeed make smooth for him the path to Bliss.","203":"We will make smooth for him the path of ease (goodness)."},"words":[{"id":7163,"position":1,"char_type_name":"word","text_uthmani":"فَسَنُيَسِّرُهُۥ","translation":{"text":"Then We will ease him","language_name":"english"},"transliteration":{"text":"fasanuyassiruhu","language_name":"english"}},{"id":7164,"position":2,"char_type_name":"word","text_uthmani":"لِلْيُسْرَىٰ","translation":{"text":"towards [the] ease","language_name":"english"},"transliteration":{"text":"lil'yus'rā","language_name":"english"}}]},{"id":6066,"verse_number":8,"verse_key":"92:8","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","trs":{"20":"But as for he who withholds and considers himself free of need","85":"There is the one who is miserly, who is self-satisfied,","22":"But he who is a greedy miser and thinks himself self-sufficient,","203":"But he who is greedy miser and thinks himself self-sufficient.<sup foot_note=155054>1</sup>"},"words":[{"id":8667,"position":1,"char_type_name":"word","text_uthmani":"وَأَمَّا","translation":{"text":"But as for","language_name":"english"},"transliteration":{"text":"wa-ammā","language_name":"english"}},{"id":8668,"position":2,"char_type_name":"word","text_uthmani":"مَنۢ","translation":{"text":"(him) who","language_name":"english"},"transliteration":{"text":"man","language_name":"english"}},{"id":8669,"position":3,"char_type_name":"word","text_uthmani":"بَخِلَ","translation":{"text":"withholds","language_name":"english"},"transliteration":{"text":"bakhila","language_name":"english"}},{"id":8670,"position":4,"char_type_name":"word","text_uthmani":"وَٱسْتَغْنَىٰ","translation":{"text":"and considers himself free from need","language_name":"english"},"transliteration":{"text":"wa-is'taghnā","language_name":"english"}}]},{"id":6067,"verse_number":9,"verse_key":"92:9","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَكَذَّبَ بِٱلْحُسْنَىٰ","trs":{"20":"And denies the best [reward],","85":"who denies goodness––","22":"And gives the lie to the best,-","203":"And belies Al-Husnâ (See the footnote of the Verse No.6)"},"words":[{"id":9922,"position":1,"char_type_name":"word","text_uthmani":"وَكَذَّبَ","translation":{"text":"And denies","language_name":"english"},"transliteration":{"text":"wakadhaba","language_name":"english"}},{"id":9923,"position":2,"char_type_name":"word","text_uthmani":"بِٱلْحُسْنَىٰ","translation":{"text":"the best","language_name":"english"},"transliteration":{"text":"bil-ḥus'nā","language_name":"english"}}]},{"id":6068,"verse_number":10,"verse_key":"92:10","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","trs":{"20":"We will ease him toward difficulty.","85":"We shall smooth his way towards hardship","22":"We will indeed make smooth for him the path to Misery;","203":"We will make smooth for him the path for evil."},"words":[{"id":11103,"position":1,"char_type_name":"word","text_uthmani":"فَسَنُيَسِّرُهُۥ","translation":{"text":"Then We will ease him","language_name":"english"},"transliteration":{"text":"fasanuyassiruhu","language_name":"english"}},{"id":11104,"position":2,"char_type_name":"word","text_uthmani":"لِلْعُسْرَىٰ","translation":{"text":"towards [the] difficulty","language_name":"english"},"transliteration":{"text":"lil'ʿus'rā","language_name":"english"}}]},{"id":6069,"verse_number":11,"verse_key":"92:11","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","trs":{"20":"And what will his wealth avail him when he falls?<sup foot_note=197776>1</sup>","85":"and his wealth will not help him as he falls.","22":"Nor will his wealth profit him when he falls headlong (into the Pit).","203":"And what will his wealth avail him when he goes down (in destruction)?."},"words":[{"id":12446,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":12447,"position":2,"char_type_name":"word","text_uthmani":"يُغْنِى","translation":{"text":"will avail","language_name":"english"},"transliteration":{"text":"yugh'nī","language_name":"english"}},{"id":12448,"position":3,"char_type_name":"word","text_uthmani":"عَنْهُ","translation":{"text":"him","language_name":"english"},"transliteration":{"text":"ʿanhu","language_name":"english"}},{"id":12449,"position":4,"char_type_name":"word","text_uthmani":"مَالُهُۥٓ","translation":{"text":"his wealth","language_name":"english"},"transliteration":{"text":"māluhu","language_name":"english"}},{"id":12450,"position":5,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":12451,"position":6,"char_type_name":"word","text_uthmani":"تَرَدَّىٰٓ","translation":{"text":"he falls","language_name":"english"},"transliteration":{"text":"taraddā","language_name":"english"}}]},{"id":6070,"verse_number":12,"verse_key":"92:12","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","trs":{"20":"Indeed, [incumbent] upon Us is guidance.","85":"Our part is to provide guidance––","22":"Verily We take upon Ourselves to guide,","203":"Truly! On Us is (to give) guidance."},"words":[{"id":13757,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":13758,"position":2,"char_type_name":"word","text_uthmani":"عَلَيْنَا","translation":{"text":"upon Us","language_name":"english"},"transliteration":{"text":"ʿalaynā","language_name":"english"}},{"id":13759,"position":3,"char_type_name":"word","text_uthmani":"لَلْهُدَىٰ","translation":{"text":"(is) the guidance","language_name":"english"},"transliteration":{"text":"lalhudā","language_name":"english"}}]},{"id":6071,"verse_number":13,"verse_key":"92:13","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","trs":{"20":"And indeed, to us belongs the Hereafter and the first [life].","85":"this world and the next belong to Us––","22":"And verily unto Us (belong) the End and the Beginning.","203":"And truly, unto Us (belong) the last (Hereafter) and the first (this world)."},"words":[{"id":14913,"position":1,"char_type_name":"word","text_uthmani":"وَإِنَّ","translation":{"text":"And indeed","language_name":"english"},"transliteration":{"text":"wa-inna","language_name":"english"}},{"id":14914,"position":2,"char_type_name":"word","text_uthmani":"لَنَا","translation":{"text":"for Us","language_name":"english"},"transliteration":{"text":"lanā","language_name":"english"}},{"id":14915,"position":3,"char_type_name":"word","text_uthmani":"لَلْـَٔاخِرَةَ","translation":{"text":"(is) the Hereafter","language_name":"english"},"transliteration":{"text":"lalākhirata","language_name":"english"}},{"id":14916,"position":4,"char_type_name":"word","text_uthmani":"وَٱلْأُولَىٰ","translation":{"text":"and the first (life)","language_name":"english"},"transliteration":{"text":"wal-ūlā","language_name":"english"}}]},{"id":6072,"verse_number":14,"verse_key":"92:14","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","trs":{"20":"So I have warned you of a Fire which is blazing.","85":"so I warn you about the raging Fire,","22":"Therefore do I warn you of a Fire blazing fiercely;","203":"Therefore I have warned you of a blazing Fire (Hell)."},"words":[{"id":16027,"position":1,"char_type_name":"word","text_uthmani":"فَأَنذَرْتُكُمْ","translation":{"text":"So I warn you","language_name":"english"},"transliteration":{"text":"fa-andhartukum","language_name":"english"}},{"id":16028,"position":2,"char_type_name":"word","text_uthmani":"نَارًۭا","translation":{"text":"(of) a Fire","language_name":"english"},"transliteration":{"text":"nāran","language_name":"english"}},{"id":16029,"position":3,"char_type_name":"word","text_uthmani":"تَلَظَّىٰ","translation":{"text":"blazing","language_name":"english"},"transliteration":{"text":"talaẓẓā","language_name":"english"}}]},{"id":6073,"verse_number":15,"verse_key":"92:15","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","trs":{"20":"None will [enter to] burn therein except the most wretched one","85":"in which none but the most wicked one will burn,","22":"None shall reach it but those most unfortunate ones","203":"None shall enter it save the most wretched."},"words":[{"id":17229,"position":1,"char_type_name":"word","text_uthmani":"لَا","translation":{"text":"Not","language_name":"english"},"transliteration":{"text":"lā","language_name":"english"}},{"id":17230,"position":2,"char_type_name":"word","text_uthmani":"يَصْلَىٰهَآ","translation":{"text":"will burn (in) it","language_name":"english"},"transliteration":{"text":"yaṣlāhā","language_name":"english"}},{"id":17231,"position":3,"char_type_name":"word","text_uthmani":"إِلَّا","translation":{"text":"except","language_name":"english"},"transliteration":{"text":"illā","language_name":"english"}},{"id":17232,"position":4,"char_type_name":"word","text_uthmani":"ٱلْأَشْقَى","translation":{"text":"the most wretched","language_name":"english"},"transliteration":{"text":"l-ashqā","language_name":"english"}}]},{"id":6074,"verse_number":16,"verse_key":"92:16","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":536,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","trs":{"20":"Who had denied and turned away.","85":"who denied [the truth], and turned away.","22":"Who give the lie to Truth and turn their backs.","203":"Who denies and turns away."},"words":[{"id":18215,"position":1,"char_type_name":"word","text_uthmani":"ٱلَّذِى","translation":{"text":"The one who","language_name":"english"},"transliteration":{"text":"alladhī","language_name":"english"}},{"id":18216,"position":2,"char_type_name":"word","text_uthmani":"كَذَّبَ","translation":{"text":"denied","language_name":"english"},"transliteration":{"text":"kadhaba","language_name":"english"}},{"id":18217,"position":3,"char_type_name":"word","text_uthmani":"وَتَوَلَّىٰ","translation":{"text":"and turned away","language_name":"english"},"transliteration":{"text":"watawallā","language_name":"engli