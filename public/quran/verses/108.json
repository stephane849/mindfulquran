{"verses":[{"id":6205,"verse_number":1,"verse_key":"108:1","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":552,"manzil_number":7,"sajdah_number":null,"page_number":602,"text_uthmani":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","trs":{"20":"Indeed, We have granted you, [O Muḥammad], al-Kawthar.","85":"We have truly given abundance to you [Prophet]––","22":"To thee have We granted the Fount (of Abundance).","203":"Verily, We have granted you (O Muhammad صلى الله عليه وسلم) Al-Kauthar (a river in Paradise).<sup foot_note=155068>1</sup>"},"words":[{"id":276,"position":1,"char_type_name":"word","text_uthmani":"إِنَّآ","translation":{"text":"Indeed, We","language_name":"english"},"transliteration":{"text":"innā","language_name":"english"}},{"id":277,"position":2,"char_type_name":"word","text_uthmani":"أَعْطَيْنَـٰكَ","translation":{"text":"We have given you","language_name":"english"},"transliteration":{"text":"aʿṭaynāka","language_name":"english"}},{"id":278,"position":3,"char_type_name":"word","text_uthmani":"ٱلْكَوْثَرَ","translation":{"text":"Al-Kauthar","language_name":"english"},"transliteration":{"text":"l-kawthara","language_name":"english"}}]},{"id":6206,"verse_number":2,"verse_key":"108:2","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":552,"manzil_number":7,"sajdah_number":null,"page_number":602,"text_uthmani":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","trs":{"20":"So pray to your Lord and offer sacrifice [to Him alone].","85":"so pray to your Lord and make your sacrifice to Him alone––","22":"Therefore to thy Lord turn in Prayer and Sacrifice.","203":"Therefore turn in prayer to your Lord and sacrifice (to Him only)."},"words":[{"id":996,"position":1,"char_type_name":"word","text_uthmani":"فَصَلِّ","translation":{"text":"So pray","language_name":"english"},"transliteration":{"text":"faṣalli","language_name":"english"}},{"id":997,"position":2,"char_type_name":"word","text_uthmani":"لِرَبِّكَ","translation":{"text":"to your Lord","language_name":"english"},"transliteration":{"text":"lirabbika","language_name":"english"}},{"id":998,"position":3,"char_type_name":"word","text_uthmani":"وَٱنْحَرْ","translation":{"text":"and sacrifice","language_name":"english"},"transliteration":{"text":"wa-in'ḥar","language_name":"english"}}]},{"id":6207,"verse_number":3,"verse_key":"108:3","juz_number":30,"rub_el_hizb_number":240,"hizb_number":60,"ruku_number":552,"manzil_number":7,"sajdah_number":null,"page_number":602,"text_uthmani":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","trs":{"20":"Indeed, your enemy is the one cut off.<sup foot_note=197824>1</sup>","85":"it is the one who hates you who has been cut off.","22":"For he who hateth thee, he will be cut off (from Future Hope).","203":"For he who hates you (O Muhammad صلى الله عليه وسلم), he will be cut off (from posterity and every good thing in this world and in the Hereafter).<sup foot_note=155069>1</sup>"},"words":[{"id":2556,"position":1,"char_type_name":"word","text_uthmani":"إِنَّ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"inna","language_name":"english"}},{"id":2557,"position":2,"char_type_name":"word","text_uthmani":"شَانِئَكَ","translation":{"text":"your enemy ","language_name":"english"},"transliteration":{"text":"shāni-aka","language_name":"english"}},{"id":2558,"position":3,"char_type_name":"word","text_uthmani":"هُوَ","translation":{"text":"he (is)","language_name":"english"},"transliteration":{"text":"huwa","language_name":"english"}},{"id":2559,"position":4,"char_type_name":"word","text_uthmani":"ٱلْأَبْتَرُ","translation":{"text":"the one cut off","language_name":"english"},"transliteration":{"text":"l-abtaru","language_name":"english"}}]}]}