:"كَانُوا۟","translation":{"text":"they were","language_name":"english"},"transliteration":{"text":"kānū","language_name":"english"}},{"id":1346,"position":17,"char_type_name":"word","text_uthmani":"مِن","translation":{"text":"from","language_name":"english"},"transliteration":{"text":"min","language_name":"english"}},{"id":1347,"position":18,"char_type_name":"word","text_uthmani":"قَبْلُ","translation":{"text":"before","language_name":"english"},"transliteration":{"text":"qablu","language_name":"english"}},{"id":1348,"position":19,"char_type_name":"word","text_uthmani":"لَفِى","translation":{"text":"surely in","language_name":"english"},"transliteration":{"text":"lafī","language_name":"english"}},{"id":1349,"position":20,"char_type_name":"word","text_uthmani":"ضَلَـٰلٍۢ","translation":{"text":"an error","language_name":"english"},"transliteration":{"text":"ḍalālin","language_name":"english"}},{"id":1350,"position":21,"char_type_name":"word","text_uthmani":"مُّبِينٍۢ","translation":{"text":"clear","language_name":"english"},"transliteration":{"text":"mubīnin","language_name":"english"}}]},{"id":5180,"verse_number":3,"verse_key":"62:3","juz_number":28,"rub_el_hizb_number":221,"hizb_number":56,"ruku_number":488,"manzil_number":7,"sajdah_number":null,"page_number":553,"text_uthmani":"وَءَاخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا۟ بِهِمْ ۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","trs":{"20":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","85":"to them and others yet to join them. He is the Almighty, the Wise:","22":"As well as (to confer all these benefits upon) others of them, who have not already joined them: And He is exalted in Might, Wise.","203":"And [He has sent him (Prophet Muhammad صلى الله عليه وسلم) also to] others among them (Muslims) who have not yet joined them (but they will come). And He (Allâh) is the All-Mighty, the All-Wise."},"words":[{"id":2416,"position":1,"char_type_name":"word","text_uthmani":"وَءَاخَرِينَ","tran