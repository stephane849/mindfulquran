{"verses":[{"id":6044,"verse_number":1,"verse_key":"91:1","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":" وَٱلشَّمْسِ وَضُحَىٰهَا","trs":{"20":"By the sun and its brightness","85":"By the sun in its morning brightness","22":"By the Sun and his (glorious) splendour;","203":"By the sun and its brightness."},"words":[{"id":793,"position":1,"char_type_name":"word","text_uthmani":"وَٱلشَّمْسِ","translation":{"text":"By the sun","language_name":"english"},"transliteration":{"text":"wal-shamsi","language_name":"english"}},{"id":794,"position":2,"char_type_name":"word","text_uthmani":"وَضُحَىٰهَا","translation":{"text":"and its brightness","language_name":"english"},"transliteration":{"text":"waḍuḥāhā","language_name":"english"}}]},{"id":6045,"verse_number":2,"verse_key":"91:2","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","trs":{"20":"And [by] the moon when it follows it","85":"and by the moon as it follows it,","22":"By the Moon as she follows him;","203":"By the moon as it follows it (the sun)."},"words":[{"id":1781,"position":1,"char_type_name":"word","text_uthmani":"وَٱلْقَمَرِ","translation":{"text":"And the moon","language_name":"english"},"transliteration":{"text":"wal-qamari","language_name":"english"}},{"id":1782,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":1783,"position":3,"char_type_name":"word","text_uthmani":"تَلَىٰهَا","translation":{"text":"it follows it","language_name":"english"},"transliteration":{"text":"talāhā","language_name":"english"}}]},{"id":6046,"verse_number":3,"verse_key":"91:3","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","trs":{"20":"And [by] the day when it displays it<sup foot_note=197770>1</sup>","85":"by the day as it displays the sun’s glory","22":"By the Day as it shows up (the Sun's) glory;","203":"By the day as it shows up (the sun’s) brightness."},"words":[{"id":2093,"position":1,"char_type_name":"word","text_uthmani":"وَٱلنَّهَارِ","translation":{"text":"And the day","language_name":"english"},"transliteration":{"text":"wal-nahāri","language_name":"english"}},{"id":2094,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":2095,"position":3,"char_type_name":"word","text_uthmani":"جَلَّىٰهَا","translation":{"text":"it displays it","language_name":"english"},"transliteration":{"text":"jallāhā","language_name":"english"}}]},{"id":6047,"verse_number":4,"verse_key":"91:4","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","trs":{"20":"And [by] the night when it covers [i.e., conceals] it","85":"and by the night as it conceals it,","22":"By the Night as it conceals it;","203":"By the night as it conceals it (the sun)."},"words":[{"id":4507,"position":1,"char_type_name":"word","text_uthmani":"وَٱلَّيْلِ","translation":{"text":"And the night","language_name":"english"},"transliteration":{"text":"wa-al-layli","language_name":"english"}},{"id":4508,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":4509,"position":3,"char_type_name":"word","text_uthmani":"يَغْشَىٰهَا","translation":{"text":"it covers it","language_name":"english"},"transliteration":{"text":"yaghshāhā","language_name":"english"}}]},{"id":6048,"verse_number":5,"verse_key":"91:5","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","trs":{"20":"And [by] the sky and He who constructed it","85":"by the sky and how He built it","22":"By the Firmament and its (wonderful) structure;","203":"By the heaven and Him Who built it."},"words":[{"id":5742,"position":1,"char_type_name":"word","text_uthmani":"وَٱلسَّمَآءِ","translation":{"text":"And the heaven","language_name":"english"},"transliteration":{"text":"wal-samāi","language_name":"english"}},{"id":5743,"position":2,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"and (He) Who","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":5744,"position":3,"char_type_name":"word","text_uthmani":"بَنَىٰهَا","translation":{"text":"constructed it","language_name":"english"},"transliteration":{"text":"banāhā","language_name":"english"}}]},{"id":6049,"verse_number":6,"verse_key":"91:6","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","trs":{"20":"And [by] the earth and He who spread it","85":"and by the earth and how He spread it,","22":"By the Earth and its (wide) expanse:","203":"By the earth and Him Who spread it."},"words":[{"id":7077,"position":1,"char_type_name":"word","text_uthmani":"وَٱلْأَرْضِ","translation":{"text":"And the earth","language_name":"english"},"transliteration":{"text":"wal-arḍi","language_name":"english"}},{"id":7078,"position":2,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"and by (He) Who","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":7079,"position":3,"char_type_name":"word","text_uthmani":"طَحَىٰهَا","translation":{"text":"spread it","language_name":"english"},"transliteration":{"text":"ṭaḥāhā","language_name":"english"}}]},{"id":6050,"verse_number":7,"verse_key":"91:7","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَنَفْسٍ وَمَا سَوَّىٰهَا","trs":{"20":"And [by] the soul and He who proportioned it<sup foot_note=197771>1</sup>","85":"by the soul and how He formed it","22":"By the Soul, and the proportion and order given to it;","203":"By Nafs (Adam or a person or a soul), and Him Who perfected him in proportion;"},"words":[{"id":8376,"position":1,"char_type_name":"word","text_uthmani":"وَنَفْسٍۢ","translation":{"text":"And (the) soul","language_name":"english"},"transliteration":{"text":"wanafsin","language_name":"english"}},{"id":8377,"position":2,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"and (He) Who","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":8378,"position":3,"char_type_name":"word","text_uthmani":"سَوَّىٰهَا","translation":{"text":"proportioned it","language_name":"english"},"transliteration":{"text":"sawwāhā","language_name":"english"}}]},{"id":6051,"verse_number":8,"verse_key":"91:8","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","trs":{"20":"And inspired it [with discernment of] its wickedness and its righteousness,","85":"and inspired it [to know] its own rebellion and piety!","22":"And its enlightenment as to its wrong and its right;-","203":"Then He showed him what is wrong for him and what is right for him."},"words":[{"id":9528,"position":1,"char_type_name":"word","text_uthmani":"فَأَلْهَمَهَا","translation":{"text":"And He inspired it","language_name":"english"},"transliteration":{"text":"fa-alhamahā","language_name":"english"}},{"id":9529,"position":2,"char_type_name":"word","text_uthmani":"فُجُورَهَا","translation":{"text":"(to distinguish) its wickedness","language_name":"english"},"transliteration":{"text":"fujūrahā","language_name":"english"}},{"id":9530,"position":3,"char_type_name":"word","text_uthmani":"وَتَقْوَىٰهَا","translation":{"text":"and its righteousness","language_name":"english"},"transliteration":{"text":"wataqwāhā","language_name":"english"}}]},{"id":6052,"verse_number":9,"verse_key":"91:9","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","trs":{"20":"He has succeeded who purifies it,","85":"The one who purifies his soul succeeds","22":"Truly he succeeds that purifies it,","203":"Indeed he succeeds who purifies his ownself (i.e. obeys and performs all that Allâh ordered, by following the true Faith of Islâmic Monotheism and by doing righteous good deeds)."},"words":[{"id":10792,"position":1,"char_type_name":"word","text_uthmani":"قَدْ","translation":{"text":"Indeed","language_name":"english"},"transliteration":{"text":"qad","language_name":"english"}},{"id":10793,"position":2,"char_type_name":"word","text_uthmani":"أَفْلَحَ","translation":{"text":"he succeeds","language_name":"english"},"transliteration":{"text":"aflaḥa","language_name":"english"}},{"id":10794,"position":3,"char_type_name":"word","text_uthmani":"مَن","translation":{"text":"who","language_name":"english"},"transliteration":{"text":"man","language_name":"english"}},{"id":10795,"position":4,"char_type_name":"word","text_uthmani":"زَكَّىٰهَا","translation":{"text":"purifies it","language_name":"english"},"transliteration":{"text":"zakkāhā","language_name":"english"}}]},{"id":6053,"verse_number":10,"verse_key":"91:10","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَقَدْ خَابَ مَن دَسَّىٰهَا","trs":{"20":"And he has failed who instills it [with corruption].","85":"and the one who corrupts it fails.","22":"And he fails that corrupts it!","203":"And indeed he fails who corrupts his ownself (i.e. disobeys what Allâh has ordered by rejecting the true Faith of Islâmic Monotheism or by following polytheism or by doing every kind of evil wicked deeds)."},"words":[{"id":12039,"position":1,"char_type_name":"word","text_uthmani":"وَقَدْ","translation":{"text":"And indeed","language_name":"english"},"transliteration":{"text":"waqad","language_name":"english"}},{"id":12040,"position":2,"char_type_name":"word","text_uthmani":"خَابَ","translation":{"text":"he fails","language_name":"english"},"transliteration":{"text":"khāba","language_name":"english"}},{"id":12041,"position":3,"char_type_name":"word","text_uthmani":"مَن","translation":{"text":"who","language_name":"english"},"transliteration":{"text":"man","language_name":"english"}},{"id":12042,"position":4,"char_type_name":"word","text_uthmani":"دَسَّىٰهَا","translation":{"text":"buries it","language_name":"english"},"transliteration":{"text":"dassāhā","language_name":"english"}}]},{"id":6054,"verse_number":11,"verse_key":"91:11","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","trs":{"20":"Thamūd denied [their prophet] by reason of their transgression,","85":"In their arrogant cruelty, the people of Thamud called [their messenger] a liar,","22":"The Thamud (people) rejected (their prophet) through their inordinate wrong-doing,","203":"Thamûd (people) denied (their Prophet) through their transgression (by rejecting the true Faith of Islâmic Monotheism, and by following polytheism, and by committing every kind of sin)."},"words":[{"id":13328,"position":1,"char_type_name":"word","text_uthmani":"كَذَّبَتْ","translation":{"text":"Denied","language_name":"english"},"transliteration":{"text":"kadhabat","language_name":"english"}},{"id":13329,"position":2,"char_type_name":"word","text_uthmani":"ثَمُودُ","translation":{"text":"Thamud","language_name":"english"},"transliteration":{"text":"thamūdu","language_name":"english"}},{"id":13330,"position":3,"char_type_name":"word","text_uthmani":"بِطَغْوَىٰهَآ","translation":{"text":"by their transgression","language_name":"english"},"transliteration":{"text":"biṭaghwāhā","language_name":"english"}}]},{"id":6055,"verse_number":12,"verse_key":"91:12","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","trs":{"20":"When the most wretched of them was sent forth.<sup foot_note=197772>1</sup>","85":"when the most wicked man among them rose [against him].","22":"Behold, the most wicked man among them was deputed (for impiety).","203":"When the most wicked man among them went forth (to kill the she-camel)."},"words":[{"id":14556,"position":1,"char_type_name":"word","text_uthmani":"إِذِ","translation":{"text":"When","language_name":"english"},"transliteration":{"text":"idhi","language_name":"english"}},{"id":14557,"position":2,"char_type_name":"word","text_uthmani":"ٱنۢبَعَثَ","translation":{"text":"(was) sent forth","language_name":"english"},"transliteration":{"text":"inbaʿatha","language_name":"english"}},{"id":14558,"position":3,"char_type_name":"word","text_uthmani":"أَشْقَىٰهَا","translation":{"text":"(the) most wicked of them","language_name":"english"},"transliteration":{"text":"ashqāhā","language_name":"english"}}]},{"id":6056,"verse_number":13,"verse_key":"91:13","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","trs":{"20":"And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"","85":"The messenger of God said to them, ‘[Leave] God’s camel to drink,’","22":"But the Messenger of Allah said to them: \"It is a She-camel of Allah! And (bar her not from) having her drink!\"","203":"But the Messenger of Allâh [Sâlih عليه السلام] said to them: \"Be cautious! (Fear the evil end). That is the she-camel of Allâh! (Do not harm it) and bar it not from having its drink!\""},"words":[{"id":15451,"position":1,"char_type_name":"word","text_uthmani":"فَقَالَ","translation":{"text":"But said","language_name":"english"},"transliteration":{"text":"faqāla","language_name":"english"}},{"id":15452,"position":2,"char_type_name":"word","text_uthmani":"لَهُمْ","translation":{"text":"to them","language_name":"english"},"transliteration":{"text":"lahum","language_name":"english"}},{"id":15453,"position":3,"char_type_name":"word","text_uthmani":"رَسُولُ","translation":{"text":"(the) Messenger","language_name":"english"},"transliteration":{"text":"rasūlu","language_name":"english"}},{"id":15454,"position":4,"char_type_name":"word","text_uthmani":"ٱللَّهِ","translation":{"text":"(of) Allah","language_name":"english"},"transliteration":{"text":"l-lahi","language_name":"english"}},{"id":15455,"position":5,"char_type_name":"word","text_uthmani":"نَاقَةَ","translation":{"text":"(It is the) she-camel","language_name":"english"},"transliteration":{"text":"nāqata","language_name":"english"}},{"id":15456,"position":6,"char_type_name":"word","text_uthmani":"ٱللَّهِ","translation":{"text":"(of) Allah","language_name":"english"},"transliteration":{"text":"l-lahi","language_name":"english"}},{"id":15457,"position":7,"char_type_name":"word","text_uthmani":"وَسُقْيَـٰهَا","translation":{"text":"and her drink","language_name":"english"},"transliteration":{"text":"wasuq'yāhā","language_name":"english"}}]},{"id":6057,"verse_number":14,"verse_key":"91:14","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","trs":{"20":"But they denied him and hamstrung<sup foot_note=197773>1</sup> her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","85":"but they called him a liar and hamstrung her. Their Lord destroyed them for their crime and levelled them.","22":"Then they rejected him (as a false prophet), and they hamstrung her. So their Lord, on account of their crime, obliterated their traces and made them equal (in destruction, high and low)!","203":"Then they denied him and they killed it. So their Lord destroyed them because of their sin, and made them equal in destruction (i.e. all grades of people, rich and poor, strong and weak, etc.)!"},"words":[{"id":15841,"position":1,"char_type_name":"word","text_uthmani":"فَكَذَّبُوهُ","translation":{"text":"But they denied him","language_name":"english"},"transliteration":{"text":"fakadhabūhu","language_name":"english"}},{"id":15842,"position":2,"char_type_name":"word","text_uthmani":"فَعَقَرُوهَا","translation":{"text":"and they hamstrung her","language_name":"english"},"transliteration":{"text":"faʿaqarūhā","language_name":"english"}},{"id":15843,"position":3,"char_type_name":"word","text_uthmani":"فَدَمْدَمَ","translation":{"text":"So destroyed","language_name":"english"},"transliteration":{"text":"fadamdama","language_name":"english"}},{"id":15844,"position":4,"char_type_name":"word","text_uthmani":"عَلَيْهِمْ","translation":{"text":"them","language_name":"english"},"transliteration":{"text":"ʿalayhim","language_name":"english"}},{"id":15845,"position":5,"char_type_name":"word","text_uthmani":"رَبُّهُم","translation":{"text":"their Lord","language_name":"english"},"transliteration":{"text":"rabbuhum","language_name":"english"}},{"id":15846,"position":6,"char_type_name":"word","text_uthmani":"بِذَنۢبِهِمْ","translation":{"text":"for their sin","language_name":"english"},"transliteration":{"text":"bidhanbihim","language_name":"english"}},{"id":15847,"position":7,"char_type_name":"word","text_uthmani":"فَسَوَّىٰهَا","translation":{"text":"and leveled them","language_name":"english"},"transliteration":{"text":"fasawwāhā","language_name":"english"}}]},{"id":6058,"verse_number":15,"verse_key":"91:15","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":535,"manzil_number":7,"sajdah_number":null,"page_number":595,"text_uthmani":"وَلَا يَخَافُ عُقْبَـٰهَا","trs":{"20":"And He does not fear the consequence thereof.<sup foot_note=197774>1</sup>","85":"He did not hesitate to punish them.","22":"And for Him is no fear of its consequences.","203":"And He (Allâh) feared not the consequences thereof."},"words":[{"id":16868,"position":1,"char_type_name":"word","text_uthmani":"وَلَا","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"walā","language_name":"english"}},{"id":16869,"position":2,"char_type_name":"word","text_uthmani":"يَخَافُ","translation":{"text":"He fears","language_name":"english"},"transliteration":{"text":"yakhāfu","language_name":"english"}},{"id":16870,"position":3,"char_type_name":"word","text_uthmani":"عُقْبَـٰهَا","translation":{"text":"its consequences","language_name":"english"},"transliteration":{"text":"ʿuq'bāhā","language_name":"english"}}]}]}