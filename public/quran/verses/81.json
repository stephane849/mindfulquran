:30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":525,"manzil_number":7,"sajdah_number":null,"page_number":586,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","trs":{"20":"A soul will [then] know what it has brought [with it].<sup foot_note=197718>1</sup>","85":"then every soul will know what it has brought about.","22":"(Then) shall each soul know what it has put forward.","203":"(Then) every person will know what he has brought (of good and evil)."},"words":[{"id":15854,"position":1,"char_type_name":"word","text_uthmani":"عَلِمَتْ","translation":{"text":"Will know","language_name":"english"},"transliteration":{"text":"ʿalimat","language_name":"english"}},{"id":15855,"position":2,"char_type_name":"word","text_uthmani":"نَفْسٌۭ","translation":{"text":"a soul","language_name":"english"},"transliteration":{"text":"nafsun","language_name":"english"}},{"id":15856,"position":3,"char_type_name":"word","text_uthmani":"مَّآ","translation":{"text":"what","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":15857,"position":4,"char_type_name":"word","text_uthmani":"أَحْضَرَتْ","translation":{"text":"it has brought","language_name":"english"},"transliteration":{"text":"aḥḍarat","language_name":"english"}}]},{"id":5815,"verse_number":15,"verse_key":"81:15","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":525,"manzil_number":7,"sajdah_number":null,"page_number":586,"text_uthmani":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","trs":{"20":"So I swear by the retreating stars -","85":"I swear by the planets","22":"So verily I call to witness the planets - that recede,","203":"So verily, I swear by the planets that recede (i.e. disappear during the day and appear during the night)."},"words":[{"id":17581,"position":1,"char_type_name":"word","text_uthmani":"فَلَآ","translation":{"text":"But nay","language_name":"english"},"transliteration":{"text":"falā","language_name":"english"}},{"id":17582,"position":2,"char_type_name":"