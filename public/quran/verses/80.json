{"text":"kallā","language_name":"english"}},{"id":13003,"position":2,"char_type_name":"word","text_uthmani":"إِنَّهَا","translation":{"text":"Indeed, it","language_name":"english"},"transliteration":{"text":"innahā","language_name":"english"}},{"id":13004,"position":3,"char_type_name":"word","text_uthmani":"تَذْكِرَةٌۭ","translation":{"text":"(is) a reminder","language_name":"english"},"transliteration":{"text":"tadhkiratun","language_name":"english"}}]},{"id":5770,"verse_number":12,"verse_key":"80:12","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"فَمَن شَآءَ ذَكَرَهُۥ","trs":{"20":"So whoever wills may remember it.<sup foot_note=197707>1</sup>","85":"from which those who wish to be taught should learn,","22":"Therefore let whoso will, keep it in remembrance.","203":"So whoever wills, let him pay attention to it."},"words":[{"id":14324,"position":1,"char_type_name":"word","text_uthmani":"فَمَن","translation":{"text":"So whosoever","language_name":"english"},"transliteration":{"text":"faman","language_name":"english"}},{"id":14325,"position":2,"char_type_name":"word","text_uthmani":"شَآءَ","translation":{"text":"wills","language_name":"english"},"transliteration":{"text":"shāa","language_name":"english"}},{"id":14326,"position":3,"char_type_name":"word","text_uthmani":"ذَكَرَهُۥ","translation":{"text":"may remember it","language_name":"english"},"transliteration":{"text":"dhakarahu","language_name":"english"}}]},{"id":5771,"verse_number":13,"verse_key":"80:13","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"فِى صُحُفٍ مُّكَرَّمَةٍ","trs":{"20":"[It is recorded] in honored sheets,","85":"[written] on honoured,","22":"(It is) in Books held (greatly) in honour,","203":"(It is) in Records held (greatly) in honour (Al-Lauh Al-Mahfûz),"},"words":[{"id":15695,"position":1