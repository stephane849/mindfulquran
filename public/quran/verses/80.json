lish"},"transliteration":{"text":"l-aʿmā","language_name":"english"}}]},{"id":5761,"verse_number":3,"verse_key":"80:3","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","trs":{"20":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified<sup foot_note=197704>1</sup>","85":"for all you know, he might have grown in spirit,","22":"But what could tell thee but that perchance he might grow (in spiritual understanding)?-","203":"And how can you know that he might become pure (from sins)?"},"words":[{"id":2814,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"But what","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":2815,"position":2,"char_type_name":"word","text_uthmani":"يُدْرِيكَ","translation":{"text":"would make you know","language_name":"english"},"transliteration":{"text":"yud'rīka","language_name":"english"}},{"id":2816,"position":3,"char_type_name":"word","text_uthmani":"لَعَلَّهُۥ","translation":{"text":"that he might","language_name":"english"},"transliteration":{"text":"laʿallahu","language_name":"english"}},{"id":2817,"position":4,"char_type_name":"word","text_uthmani":"يَزَّكَّىٰٓ","translation":{"text":"purify himself","language_name":"english"},"transliteration":{"text":"yazzakkā","language_name":"english"}}]},{"id":5762,"verse_number":4,"verse_key":"80:4","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","trs":{"20":"Or be reminded and the remembrance would benefit him?","85":"or taken note of something useful to him.","22":"Or that he might receive admonition, and the teaching might profit him?","203":"Or he might receive admonition, and the admonition might profit him?"},"words":[{"id":4187,"position":1,"char_type_name":"word","text_uthmani":"أَوْ","translation":{"text":"Or","language_name":"english"},"transliteration":{"text":"aw","language_name":"english"}},{"id":4188,"position":2,"char_type_name":"word","text_uthmani":"يَذَّكَّرُ","translation":{"text":"be reminded","language_name":"english"},"transliteration":{"text":"yadhakkaru","language_name":"english"}},{"id":4189,"position":3,"char_type_name":"word","text_uthmani":"فَتَنفَعَهُ","translation":{"text":"so would benefit him","language_name":"english"},"transliteration":{"text":"fatanfaʿahu","language_name":"english"}},{"id":4190,"position":4,"char_type_name":"word","text_uthmani":"ٱلذِّكْرَىٰٓ","translation":{"text":"the reminder","language_name":"english"},"transliteration":{"text":"l-dhik'rā","language_name":"english"}}]},{"id":5763,"verse_number":5,"verse_key":"80:5","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"أَمَّا مَنِ ٱسْتَغْنَىٰ","trs":{"20":"As for he who thinks himself without need,<sup foot_note=197705>1</sup>","85":"For the self-satisfied one","22":"As to one who regards Himself as self-sufficient,","203":"As for him who thinks himself self-sufficient,"},"words":[{"id":5455,"position":1,"char_type_name":"word","text_uthmani":"أَمَّا","translation":{"text":"As for","language_name":"english"},"transliteration":{"text":"ammā","language_name":"english"}},{"id":5456,"position":2,"char_type_name":"word","text_uthmani":"مَنِ","translation":{"text":"(him) who","language_name":"english"},"transliteration":{"text":"mani","language_name":"english"}},{"id":5457,"position":3,"char_type_name":"word","text_uthmani":"ٱسْتَغْنَىٰ","translation":{"text":"considers himself free from need","language_name":"english"},"transliteration":{"text":"is'taghnā","language_name":"english"}}]},{"id":5764,"verse_number":6,"verse_key":"80:6","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"فَأَنتَ لَهُۥ تَصَدَّىٰ","trs":{"20":"To him you give attention.","85":"you go out of your way––","22":"To him dost thou attend;","203":"To him you attend;"},"words":[{"id":6685,"position":1,"char_type_name":"word","text_uthmani":"فَأَنتَ","translation":{"text":"So you","language_name":"english"},"transliteration":{"text":"fa-anta","language_name":"english"}},{"id":6686,"position":2,"char_type_name":"word","text_uthmani":"لَهُۥ","translation":{"text":"to him","language_name":"english"},"transliteration":{"text":"lahu","language_name":"english"}},{"id":6687,"position":3,"char_type_name":"word","text_uthmani":"تَصَدَّىٰ","translation":{"text":"give attention","language_name":"english"},"transliteration":{"text":"taṣaddā","language_name":"english"}}]},{"id":5765,"verse_number":7,"verse_key":"80:7","juz_number":30,"rub_el_hizb_number":234,"hizb_number":59,"ruku_number":524,"manzil_number":7,"sajdah_number":null,"page_number":585,"text_uthmani":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","trs":{"20":"And not upon you [is any blame] if he will not be purified.<sup foot_note=197706>1</sup>","85":"though you are not to be blamed for his lack of spiritual growth––","22":"Though it is no blame to thee if he grow not (in spiritual understanding).","203":"What does it matter to you if he will not become pure (from disbelief: you are only a Messenger, your duty is to convey the Message of Allâh)."},"words":[{"id":8029,"position":1,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"And not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":8030,"position":2,"char_type_name":"word","text_uthmani":"عَلَيْكَ","translation":{"text":"upon you","language_name":"english"},"transliteration":{"text":"ʿalayka","language_name":"english"}},{"id":8031,"position":3,"char_type_name":"word","text_uthmani":"أَلَّا","translation":{"text":"that not","langu