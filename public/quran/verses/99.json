glish"}},{"id":1840,"position":2,"char_type_name":"word","text_uthmani":"ٱلْأَرْضُ","translation":{"text":"the earth","language_name":"english"},"transliteration":{"text":"l-arḍu","language_name":"english"}},{"id":1841,"position":3,"char_type_name":"word","text_uthmani":"أَثْقَالَهَا","translation":{"text":"its burdens","language_name":"english"},"transliteration":{"text":"athqālahā","language_name":"english"}}]},{"id":6141,"verse_number":3,"verse_key":"99:3","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":543,"manzil_number":7,"sajdah_number":null,"page_number":599,"text_uthmani":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا","trs":{"20":"And man says,<sup foot_note=197794>1</sup> \"What is [wrong] with it?\" -","85":"when man cries, ‘What is happening to it?’;","22":"And man cries (distressed): 'What is the matter with her?'-","203":"And man will say: \"What is the matter with it?\""},"words":[{"id":2911,"position":1,"char_type_name":"word","text_uthmani":"وَقَالَ","translation":{"text":"And says","language_name":"english"},"transliteration":{"text":"waqāla","language_name":"english"}},{"id":2912,"position":2,"char_type_name":"word","text_uthmani":"ٱلْإِنسَـٰنُ","translation":{"text":"man","language_name":"english"},"transliteration":{"text":"l-insānu","language_name":"english"}},{"id":2913,"position":3,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"What","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":2914,"position":4,"char_type_name":"word","text_uthmani":"لَهَا","translation":{"text":"(is) with it","language_name":"english"},"transliteration":{"text":"lahā","language_name":"english"}}]},{"id":6142,"verse_number":4,"verse_key":"99:4","juz_number":30,"rub_el_hizb_number":239,"hizb_number":60,"ruku_number":543,"manzil_number":7,"sajdah_number":null,"page_number":599,"text_uthmani":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","trs":{"20":"That Day, it will report its news","85":"on that Day, it will