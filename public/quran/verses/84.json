:{"20":"O mankind, indeed you are laboring toward your Lord with [great] exertion<sup foot_note=197738>1</sup> and will meet it.<sup foot_note=197737>2</sup>","85":"you humans, toiling laboriously towards your Lord, will meet Him:","22":"O thou man! Verily thou art ever toiling on towards thy Lord- painfully toiling,- but thou shalt meet Him.","203":"O man! Verily, you are returning towards your Lord with your deeds and actions (good or bad), a sure returning, and you will meet (the results of your deeds which you did)."},"words":[{"id":6720,"position":1,"char_type_name":"word","text_uthmani":"يَـٰٓأَيُّهَا","translation":{"text":"O","language_name":"english"},"transliteration":{"text":"yāayyuhā","language_name":"english"}},{"id":6721,"position":2,"char_type_name":"word","text_uthmani":"ٱلْإِنسَـٰنُ","translation":{"text":"mankind","language_name":"english"},"transliteration":{"text":"l-insānu","language_name":"english"}},{"id":6722,"position":3,"char_type_name":"word","text_uthmani":"إِنَّكَ","translation":{"text":"Indeed, you","language_name":"english"},"transliteration":{"text":"innaka","language_name":"english"}},{"id":6723,"position":4,"char_type_name":"word","text_uthmani":"كَادِحٌ","translation":{"text":"(are) laboring","language_name":"english"},"transliteration":{"text":"kādiḥun","language_name":"english"}},{"id":6724,"position":5,"char_type_name":"word","text_uthmani":"إِلَىٰ","translation":{"text":"to","language_name":"english"},"transliteration":{"text":"ilā","language_name":"english"}},{"id":6725,"position":6,"char_type_name":"word","text_uthmani":"رَبِّكَ","translation":{"text":"your Lord","language_name":"english"},"transliteration":{"text":"rabbika","language_name":"english"}},{"id":6726,"position":7,"char_type_name":"word","text_uthmani":"كَدْحًۭا","translation":{"text":"(with) exertion","language_name":"english"},"transliteration":{"text":"kadḥan","language_name":"english"}},{"id":6727,"position":8,"char_type_name":"word","text_uthmani":"فَمُلَـٰقِ