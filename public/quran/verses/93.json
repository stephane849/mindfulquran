{"verses":[{"id":6080,"verse_number":1,"verse_key":"93:1","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":" وَٱلضُّحَىٰ","trs":{"20":"By the morning brightness","85":"By the morning brightness","22":"By the Glorious Morning Light,","203":"By the forenoon (after sunrise).<sup foot_note=155055>1</sup>"},"words":[{"id":70,"position":1,"char_type_name":"word","text_uthmani":"وَٱلضُّحَىٰ","translation":{"text":"By the morning brightness","language_name":"english"},"transliteration":{"text":"wal-ḍuḥā","language_name":"english"}}]},{"id":6081,"verse_number":2,"verse_key":"93:2","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَٱلَّيْلِ إِذَا سَجَىٰ","trs":{"20":"And [by] the night when it covers with darkness,<sup foot_note=197778>1</sup>","85":"and by the night when it grows still,","22":"And by the Night when it is still,-","203":"By the night when it darkens (and stand still)."},"words":[{"id":1191,"position":1,"char_type_name":"word","text_uthmani":"وَٱلَّيْلِ","translation":{"text":"And the night","language_name":"english"},"transliteration":{"text":"wa-al-layli","language_name":"english"}},{"id":1192,"position":2,"char_type_name":"word","text_uthmani":"إِذَا","translation":{"text":"when","language_name":"english"},"transliteration":{"text":"idhā","language_name":"english"}},{"id":1193,"position":3,"char_type_name":"word","text_uthmani":"سَجَىٰ","translation":{"text":"it covers with darkness","language_name":"english"},"transliteration":{"text":"sajā","language_name":"english"}}]},{"id":6082,"verse_number":3,"verse_key":"93:3","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","trs":{"20":"Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].","85":"your Lord has not forsaken you [Prophet], nor does He hate you,","22":"Thy Guardian-Lord hath not forsaken thee, nor is He displeased.","203":"Your Lord (O Muhammad صلى الله عليه وسلم) has neither forsaken you nor hates you."},"words":[{"id":2251,"position":1,"char_type_name":"word","text_uthmani":"مَا","translation":{"text":"Not","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":2252,"position":2,"char_type_name":"word","text_uthmani":"وَدَّعَكَ","translation":{"text":"has forsaken you","language_name":"english"},"transliteration":{"text":"waddaʿaka","language_name":"english"}},{"id":2253,"position":3,"char_type_name":"word","text_uthmani":"رَبُّكَ","translation":{"text":"your Lord","language_name":"english"},"transliteration":{"text":"rabbuka","language_name":"english"}},{"id":2254,"position":4,"char_type_name":"word","text_uthmani":"وَمَا","translation":{"text":"and not","language_name":"english"},"transliteration":{"text":"wamā","language_name":"english"}},{"id":2255,"position":5,"char_type_name":"word","text_uthmani":"قَلَىٰ","translation":{"text":"He is displeased","language_name":"english"},"transliteration":{"text":"qalā","language_name":"english"}}]},{"id":6083,"verse_number":4,"verse_key":"93:4","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","trs":{"20":"And the Hereafter is better for you than the first [life].","85":"and the future will be better for you than the past;","22":"And verily the Hereafter will be better for thee than the present.","203":"And indeed the Hereafter is better for you than the present (life of this world)."},"words":[{"id":3555,"position":1,"char_type_name":"word","text_uthmani":"وَلَلْـَٔاخِرَةُ","translation":{"text":"And surely the Hereafter","language_name":"english"},"transliteration":{"text":"walalākhiratu","language_name":"english"}},{"id":3556,"position":2,"char_type_name":"word","text_uthmani":"خَيْرٌۭ","translation":{"text":"(is) better","language_name":"english"},"transliteration":{"text":"khayrun","language_name":"english"}},{"id":3557,"position":3,"char_type_name":"word","text_uthmani":"لَّكَ","translation":{"text":"for you","language_name":"english"},"transliteration":{"text":"laka","language_name":"english"}},{"id":3558,"position":4,"char_type_name":"word","text_uthmani":"مِنَ","translation":{"text":"than","language_name":"english"},"transliteration":{"text":"mina","language_name":"english"}},{"id":3559,"position":5,"char_type_name":"word","text_uthmani":"ٱلْأُولَىٰ","translation":{"text":"the first","language_name":"english"},"transliteration":{"text":"l-ūlā","language_name":"english"}}]},{"id":6084,"verse_number":5,"verse_key":"93:5","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","trs":{"20":"And your Lord is going to give you, and you will be satisfied.","85":"your Lord is sure to give you so much that you will be well satisfied.","22":"And soon will thy Guardian-Lord give thee (that wherewith) thou shalt be well-pleased.","203":"And verily, your Lord will give you (all good) so that you shall be well-pleased."},"words":[{"id":4814,"position":1,"char_type_name":"word","text_uthmani":"وَلَسَوْفَ","translation":{"text":"And soon","language_name":"english"},"transliteration":{"text":"walasawfa","language_name":"english"}},{"id":4815,"position":2,"char_type_name":"word","text_uthmani":"يُعْطِيكَ","translation":{"text":"will give you","language_name":"english"},"transliteration":{"text":"yuʿ'ṭīka","language_name":"english"}},{"id":4816,"position":3,"char_type_name":"word","text_uthmani":"رَبُّكَ","translation":{"text":"your Lord","language_name":"english"},"transliteration":{"text":"rabbuka","language_name":"english"}},{"id":4817,"position":4,"char_type_name":"word","text_uthmani":"فَتَرْضَىٰٓ","translation":{"text":"then you will be satisfied","language_name":"english"},"transliteration":{"text":"fatarḍā","language_name":"english"}}]},{"id":6085,"verse_number":6,"verse_key":"93:6","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","trs":{"20":"Did He not find you an orphan and give [you] refuge?","85":"Did He not find you an orphan and shelter you?","22":"Did He not find thee an orphan and give thee shelter (and care)?","203":"Did He not find you (O Muhammad صلى الله عليه وسلم) an orphan and gave you a refuge?"},"words":[{"id":5889,"position":1,"char_type_name":"word","text_uthmani":"أَلَمْ","translation":{"text":"Did not","language_name":"english"},"transliteration":{"text":"alam","language_name":"english"}},{"id":5890,"position":2,"char_type_name":"word","text_uthmani":"يَجِدْكَ","translation":{"text":"He find you","language_name":"english"},"transliteration":{"text":"yajid'ka","language_name":"english"}},{"id":5891,"position":3,"char_type_name":"word","text_uthmani":"يَتِيمًۭا","translation":{"text":"an orphan","language_name":"english"},"transliteration":{"text":"yatīman","language_name":"english"}},{"id":5892,"position":4,"char_type_name":"word","text_uthmani":"فَـَٔاوَىٰ","translation":{"text":"and give shelter","language_name":"english"},"transliteration":{"text":"faāwā","language_name":"english"}}]},{"id":6086,"verse_number":7,"verse_key":"93:7","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","trs":{"20":"And He found you lost and guided [you],","85":"Did He not find you lost and guide you?","22":"And He found thee wandering, and He gave thee guidance.","203":"And He found you unaware (of the Qur’ân, its laws, and Prophethood) and guided you?"},"words":[{"id":7732,"position":1,"char_type_name":"word","text_uthmani":"وَوَجَدَكَ","translation":{"text":"And He found you","language_name":"english"},"transliteration":{"text":"wawajadaka","language_name":"english"}},{"id":7733,"position":2,"char_type_name":"word","text_uthmani":"ضَآلًّۭا","translation":{"text":"lost","language_name":"english"},"transliteration":{"text":"ḍāllan","language_name":"english"}},{"id":7734,"position":3,"char_type_name":"word","text_uthmani":"فَهَدَىٰ","translation":{"text":"so He guided","language_name":"english"},"transliteration":{"text":"fahadā","language_name":"english"}}]},{"id":6087,"verse_number":8,"verse_key":"93:8","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","trs":{"20":"And He found you poor and made [you] self-sufficient.","85":"Did He not find you in need and make you self-sufficient?","22":"And He found thee in need, and made thee independent.","203":"And He found you poor and made you rich (self-sufficient with self-contentment)?"},"words":[{"id":8971,"position":1,"char_type_name":"word","text_uthmani":"وَوَجَدَكَ","translation":{"text":"And He found you","language_name":"english"},"transliteration":{"text":"wawajadaka","language_name":"english"}},{"id":8972,"position":2,"char_type_name":"word","text_uthmani":"عَآئِلًۭا","translation":{"text":"in need","language_name":"english"},"transliteration":{"text":"ʿāilan","language_name":"english"}},{"id":8973,"position":3,"char_type_name":"word","text_uthmani":"فَأَغْنَىٰ","translation":{"text":"so He made self-sufficient","language_name":"english"},"transliteration":{"text":"fa-aghnā","language_name":"english"}}]},{"id":6088,"verse_number":9,"verse_key":"93:9","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","trs":{"20":"So as for the orphan, do not oppress [him].","85":"So do not be harsh with the orphan","22":"Therefore, treat not the orphan with harshness,","203":"Therefore, treat not the orphan with oppression."},"words":[{"id":10182,"position":1,"char_type_name":"word","text_uthmani":"فَأَمَّا","translation":{"text":"So as for","language_name":"english"},"transliteration":{"text":"fa-ammā","language_name":"english"}},{"id":10183,"position":2,"char_type_name":"word","text_uthmani":"ٱلْيَتِيمَ","translation":{"text":"the orphan","language_name":"english"},"transliteration":{"text":"l-yatīma","language_name":"english"}},{"id":10184,"position":3,"char_type_name":"word","text_uthmani":"فَلَا","translation":{"text":"then (do) not","language_name":"english"},"transliteration":{"text":"falā","language_name":"english"}},{"id":10185,"position":4,"char_type_name":"word","text_uthmani":"تَقْهَرْ","translation":{"text":"oppress","language_name":"english"},"transliteration":{"text":"taqhar","language_name":"english"}}]},{"id":6089,"verse_number":10,"verse_key":"93:10","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","trs":{"20":"And as for the petitioner,<sup foot_note=197779>1</sup> do not repel [him].","85":"and do not chide the one who asks for help;","22":"Nor repulse the petitioner (unheard);","203":"And repulse not the beggar."},"words":[{"id":11376,"position":1,"char_type_name":"word","text_uthmani":"وَأَمَّا","translation":{"text":"And as for","language_name":"english"},"transliteration":{"text":"wa-ammā","language_name":"english"}},{"id":11377,"position":2,"char_type_name":"word","text_uthmani":"ٱلسَّآئِلَ","translation":{"text":"one who asks","language_name":"english"},"transliteration":{"text":"l-sāila","language_name":"english"}},{"id":11378,"position":3,"char_type_name":"word","text_uthmani":"فَلَا","translation":{"text":"then (do) not","language_name":"english"},"transliteration":{"text":"falā","language_name":"english"}},{"id":11379,"position":4,"char_type_name":"word","text_uthmani":"تَنْهَرْ","translation":{"text":"repel","language_name":"english"},"transliteration":{"text":"tanhar","language_name":"english"}}]},{"id":6090,"verse_number":11,"verse_key":"93:11","juz_number":30,"rub_el_hizb_number":238,"hizb_number":60,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"page_number":596,"text_uthmani":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","trs":{"20":"But as for the favor of your Lord, report [it].","85":"talk about the blessings of your Lord.","22":"But the bounty of the Lord - rehearse and proclaim!","203":"And proclaim the Grace of your Lord (i.e. the Prophethood and all other Graces)."},"words":[{"id":12598,"position":1,"char_type_name":"word","text_uthmani":"وَأَمَّا","translation":{"text":"But as for","language_name":"english"},"transliteration":{"text":"wa-ammā","language_name":"english"}},{"id":12599,"position":2,"char_type_name":"word","text_uthmani":"بِنِعْمَةِ","translation":{"text":"(the) Favor","language_name":"english"},"transliteration":{"text":"biniʿ'mati","language_name":"english"}},{"id":12600,"position":3,"char_type_name":"word","text_uthmani":"رَبِّكَ","translation":{"text":"(of) your Lord","language_name":"english"},"transliteration":{"text":"rabbika","language_name":"english"}},{"id":12601,"position":4,"char_type_name":"word","text_uthmani":"فَحَدِّثْ","translation":{"text":"narrate","language_name":"english"},"transliteration":{"text":"faḥaddith","language_name":"english"}}]}]}